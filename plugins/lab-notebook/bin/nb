                 "spec_hash", "frozen_at", "deviations", "runs", "predictions", "provenance",
                 "metrics", "confirmed_at", "audited_at", "retrospective", "verdicts", "reviews"} | FIXED_FIELDS
APPEND_LISTS = {"log", "links", "refs", "tags", "deviations", "runs", "verdicts", "reviews"}

SAME = "same"
EDGES = {
    "refines": ({"question"}, {"goal", "question"}),
    "addresses": ({"hypothesis"}, {"question"}),
    "tests": ({"experiment"}, {"hypothesis"}),
    "investigates": ({"exploration"}, {"question"}),
    "produces": ({"experiment", "exploration"}, {"result"}),
    "derived-from": ({"conclusion"}, {"result"}),
