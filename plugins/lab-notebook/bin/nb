# ---------------------------------------------------------------- schema ---

SCHEMA = 2
DEFAULT_REF = "refs/notebook/data"
ORIGIN_REF = "refs/notebook/origin"
RETRIES = 30
LIST_LIMIT = 50

PREFIX = {
    "goal": "goal", "question": "q", "hypothesis": "hyp", "experiment": "exp",
    "exploration": "xpl", "result": "res", "conclusion": "con", "lead": "lead",
    "decision": "dec", "audit": "aud",
}
TYPE_OF_PREFIX = {v: k for k, v in PREFIX.items()}
ID_CHARS = "0123456789abcdefghjkmnpqrstvwxyz"  # no i l o u
ID_RE = re.compile(r"^(%s)-[%s]{4,}$" % ("|".join(PREFIX.values()), ID_CHARS))
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")

# Statuses per type, initial first. Audits have none.
STATUSES = {
    "goal": ["pending", "active", "superseded", "rejected"],
    "question": ["open", "answered", "settled", "parked", "abandoned"],
    "hypothesis": ["open", "supported", "refuted", "contested", "superseded"],
    "experiment": ["draft", "frozen", "done", "abandoned"],
    "exploration": ["draft", "frozen", "done", "abandoned"],
    "result": ["valid", "invalidated"],
    "conclusion": ["pending", "supported", "refuted", "superseded", "rejected"],
    "lead": ["pending", "active", "followed", "dropped"],
    "decision": ["pending", "active", "superseded", "rejected"],
}
# Types that start pending when Claude authors them, and their established status.
ESTABLISHED = {"goal": "active", "conclusion": "supported", "lead": "active", "decision": "active"}
REJECTED = {"goal": "rejected", "conclusion": "rejected", "lead": "dropped", "decision": "rejected"}
INITIAL = {"draft", "open", "pending"}

# Moves allowed through `nb status`. Others happen through freeze, confirm,
# reject, invalidate and supersession.
STATUS_MOVES = {
    "question": {"open": {"answered", "settled", "parked", "abandoned"},
                 "parked": {"open", "abandoned"}, "answered": {"open"}, "settled": {"open"}},
    # A hypothesis's status is derived from its verdicts (see Graph.hyp_events); by hand it can
    # only be retired.
    "hypothesis": {"open": {"superseded"}, "supported": {"superseded"}, "refuted": {"superseded"},
                   "contested": {"superseded"}},
    # An experiment becomes done when every predicted hypothesis has a current verdict.
    "experiment": {"draft": {"abandoned"}, "frozen": {"abandoned"}},
    "exploration": {"draft": {"abandoned"}, "frozen": {"done", "abandoned"}},
    "conclusion": {"supported": {"refuted"}},
    "lead": {"active": {"followed", "dropped"}, "followed": {"dropped"}},
}

# name -> type. Order is the serialisation order.
COMMON = {
    "id": str, "type": str, "title": str, "author": str, "created": str, "updated": str,
    "status": str, "body": str, "refs": list, "tags": list, "links": list, "log": list,
}
RUN_FIELDS = {
    "spec": str, "execution": str, "predictions": list, "spec_hash": str,
