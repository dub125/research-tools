    "uses": ({"experiment", "exploration"}, {"result", "experiment", "exploration"}),
    "based-on": ({"decision"}, {"result", "conclusion"}),
    "affects": ({"decision"}, {"goal", "question", "hypothesis", "experiment", "exploration"}),
}
ACYCLIC = ["refines", "supersedes", "variant-of"]
# type -> (rel, min, max) links a node must have from creation on.
REQUIRED_LINKS = {
    "question": ("refines", 1, None), "hypothesis": ("addresses", 1, None),
    "exploration": ("investigates", 1, None), "conclusion": ("derived-from", 1, None),
    "lead": ("suggested-by", 1, None), "audit": ("audits", 1, 1),
}
# Upward edges for "path to a goal" (lint, freeze) and the extra ones `nb path` shows.
UP = {"experiment": ["tests"], "exploration": ["investigates"],
      "hypothesis": ["addresses"], "question": ["refines"]}
UP_EXTRA = {"conclusion": ["answers", "derived-from"], "lead": ["suggested-by"],
            "decision": ["affects", "based-on"], "audit": ["audits"]}

CONFIG_DEFAULTS = {
    "prime_max_chars": 4000,
    "prime_section_limit": 5,
    "pending_days": 7,
    "drift_leads": 2,
    "min_results_supported": 1,
    "run_patterns": [],
    "freeze_gate": False,
    "audit_before_confirm": True,
    "auditor_model": "sonnet",
    "brief_tier_limit": 8,
}


class NbError(Exception):
    pass


def today():
    return os.environ.get("NB_TODAY") or datetime.date.today().isoformat()


def now_at():
    """UTC write time, YYYY-MM-DDTHH:MM:SSZ. Under NB_TODAY the date comes from it and the time of
    day from the clock, so events written in one test still order by when they were written."""
    now = datetime.datetime.now(datetime.timezone.utc)
    return "%sT%s" % (os.environ.get("NB_TODAY") or now.strftime("%Y-%m-%d"), now.strftime("%H:%M:%SZ"))


def age_days(date):
    try:
        return (datetime.date.fromisoformat(today()) - datetime.date.fromisoformat(date)).days
    except (TypeError, ValueError):
        return 0


def author():
    """claude inside Claude Code's Bash tool, user otherwise. Deliberately no override."""
    return "claude" if os.environ.get("CLAUDECODE") else "user"


def ref_name():
    return os.environ.get("NB_REF") or DEFAULT_REF


# ------------------------------------------------------------------ git ---

def repo_root():
    res = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if res.returncode != 0:
        raise NbError("not inside a git repository")
    return Path(res.stdout.strip())


class Git:
    def __init__(self, root):
        self.root = root

    def run(self, *args, input=None, env=None, check=True, text=True):
        res = subprocess.run(["git", "-C", str(self.root)] + list(args), input=input,
                             capture_output=True, text=text, env=env)
        if check and res.returncode != 0:
            err = res.stderr if text else res.stderr.decode(errors="replace")
            raise NbError("git %s failed: %s" % (args[0], err.strip()))
        return res

    def ok(self, *args):
        return self.run(*args, check=False).returncode == 0

    def rev(self, name):
        res = self.run("rev-parse", "--verify", "-q", name + "^{commit}", check=False)
        return res.stdout.strip() or None

    def read_tree(self, commit):
        """{path: (blob sha, bytes)} for every blob under commit."""
        out = self.run("ls-tree", "-r", "-z", commit).stdout
        entries = []
        for item in out.split("\0"):
            if item:
                meta, path = item.split("\t", 1)
                entries.append((path, meta.split()[2]))
        if not entries:
            return {}
        data = self.run("cat-file", "--batch", input="".join(s + "\n" for _, s in entries).encode(),
                        text=False).stdout
        blobs, pos = {}, 0
        for path, sha in entries:
            nl = data.index(b"\n", pos)
            size = int(data[pos:nl].split()[2])
            blobs[path] = (sha, data[nl + 1:nl + 1 + size])
            pos = nl + 1 + size + 1
        return blobs

    def hash_blob(self, text):
        return self.run("hash-object", "-w", "--stdin", input=text).stdout.strip()

    def mktree(self, entries):
        """entries: [(mode, kind, sha, name)]"""
        lines = "".join("%s %s %s\t%s\n" % e for e in entries)
        return self.run("mktree", input=lines).stdout.strip()

    def commit_tree(self, tree, parents, message):
        env = dict(os.environ)
        if not self.run("config", "user.name", check=False).stdout.strip():
            env.update(GIT_AUTHOR_NAME="nb", GIT_COMMITTER_NAME="nb")
        if not self.run("config", "user.email", check=False).stdout.strip():
            env.update(GIT_AUTHOR_EMAIL="nb@localhost", GIT_COMMITTER_EMAIL="nb@localhost")
        args = ["commit-tree", tree]
        for p in parents:
            args += ["-p", p]
        return self.run(*args, "-m", message, env=env).stdout.strip()

    def swap(self, ref, new, old):
        """Compare-and-swap the ref. False if someone else moved it first."""
        res = self.run("update-ref", ref, new, old or "", check=False)
        if res.returncode == 0:
            return True
        if "cannot lock ref" in res.stderr or "but expected" in res.stderr or "already exists" in res.stderr:
            return False
        raise NbError("git update-ref failed: %s" % res.stderr.strip())


# ---------------------------------------------------------------- graph ---

def canonical(obj):
    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(",", ":"))


def spec_hash(n):
    keys = {k: n.get(k, "" if k != "predictions" else []) for k in ("title", "spec", "execution", "predictions")}
    return hashlib.sha256(canonical(keys).encode()).hexdigest()


def fields_of(t):
    return dict(COMMON, **TYPE_FIELDS.get(t, {}))


def serialise(n):
    rec = {}
    for k in fields_of(n.get("type")):
        if k in n and n[k] not in ("", [], {}, None, False):
            rec[k] = n[k]
    for k in n:  # unknown fields survive so validation can report them
        if k not in rec and n[k] not in ("", [], {}, None, False):
            rec[k] = n[k]
    return json.dumps(rec, indent=2, ensure_ascii=False) + "\n"


def default(kind):
    return {str: "", list: [], dict: {}, bool: False}[kind]


class Graph:
    def __init__(self, git, head, meta, nodes, blobs):
        self.git, self.head, self.meta, self.nodes, self.blobs = git, head, meta, nodes, blobs
        self._inbound = None
        self._ranks = None

    @classmethod
    def load(cls, git, commit=None, required=True):
        commit = commit or git.rev(ref_name())
        if not commit:
            if required:
                raise NbError("no notebook in this repository; run `nb init`")
            return cls(git, None, {"schema": SCHEMA, "config": {}}, {}, {})
        meta, nodes, blobs = {"schema": SCHEMA, "config": {}}, {}, {}
        for path, (sha, data) in git.read_tree(commit).items():
            try:
                obj = json.loads(data.decode())
            except ValueError:
                raise NbError("%s in the notebook is not valid JSON" % path)
            if path == "meta.json":
                meta = obj
            elif path.startswith("nodes/") and path.endswith(".json"):
                nodes[obj.get("id", path[6:-5])] = obj
                blobs[obj.get("id", path[6:-5])] = (data.decode(), sha)
        if meta.get("schema", 0) > SCHEMA:
            raise NbError("notebook schema %s is newer than this nb (%d); update the plugin" % (meta["schema"], SCHEMA))
        old = meta.get("schema", 0)
        meta["schema"] = SCHEMA
        meta.setdefault("config", {})
        for n in nodes.values():
            for k, kind in fields_of(n.get("type")).items():
                n.setdefault(k, default(kind))
        g = cls(git, commit, meta, nodes, blobs)
        if old < 2:  # migrations from older schemas, in memory; the next write stores them
            g.migrate_hyp_status()
        return g

    # -- lookup

    def config(self, key):
        return self.meta["config"].get(key, CONFIG_DEFAULTS[key])

    def resolve(self, term, types=None):
        if term in self.nodes:
            nid = term
        else:
            hits = sorted(k for k in self.nodes if k.startswith(term))
            if not hits:
                raise NbError("no node matching %r" % term)
            if len(hits) > 1:
                raise NbError("%r is ambiguous: %s" % (term, ", ".join(hits[:10])))
            nid = hits[0]
        if types and self.nodes[nid]["type"] not in types:
            raise NbError("%s is a %s, expected %s" % (nid, self.nodes[nid]["type"], " or ".join(sorted(types))))
        return nid

    def type(self, nid):
        return self.nodes[nid]["type"] if nid in self.nodes else None

    def status(self, nid):
        return self.nodes[nid].get("status", "") if nid in self.nodes else ""

    def out(self, nid, *rels):
        return [l["to"] for l in self.nodes[nid]["links"] if l["rel"] in rels]

    @property
    def inbound(self):
        if self._inbound is None:
            idx = {}
            for nid, n in self.nodes.items():
                for l in n["links"]:
                    idx.setdefault(l["to"], []).append((l["rel"], nid))
            self._inbound = idx
        return self._inbound

    def into(self, nid, *rels):
        return [f for r, f in self.inbound.get(nid, []) if r in rels]

    def changed(self):
        self._inbound = None

    def producer(self, rid):
        p = self.into(rid, "produces")
        return p[0] if p else None

    def new_id(self, t):
        rng = random.SystemRandom()
        for attempt in range(20):
            length = 4 if attempt < 10 else 5
            nid = "%s-%s" % (PREFIX[t], "".join(rng.choice(ID_CHARS) for _ in range(length)))
            if nid not in self.nodes:
                return nid
        raise NbError("could not draw a free id")

    # -- paths and lineage

    def paths(self, nid, extra=False, limit=20):
        """Every upward path from nid to a goal, as lists of ids."""
        found = []

        def ups(x):
            t = self.type(x)
            if t == "result":
                return [p for p in [self.producer(x)] if p]
            rels = UP.get(t, []) + (UP_EXTRA.get(t, []) if extra else [])
            return [y for y in self.out(x, *rels) if y in self.nodes]

        def walk(x, trail):
            if len(found) >= limit:
                return
            if self.type(x) == "goal":
                found.append(trail)
                return
            for y in ups(x):
                if y not in trail:
                    walk(y, trail + [y])

        walk(nid, [nid])
        return found

    def has_active_goal(self, nid):
        return any(self.status(p[-1]) == "active" for p in self.paths(nid, limit=200))

    def lineage_parents(self, nid):
        t = self.type(nid)
        if t == "hypothesis":
            return self.into(nid, "spawns") + self.out(nid, "addresses")
        if t == "question":
            return self.into(nid, "raises") + [q for q in self.out(nid, "refines") if self.type(q) == "question"]
        if t == "lead":
            return self.out(nid, "suggested-by")
        if t == "result":
            return self.into(nid, "produces")
        if t == "experiment":
            return self.into(nid, "spawns") + self.out(nid, "tests")
        if t == "exploration":
            return self.into(nid, "spawns") + self.out(nid, "investigates")
        return []

    def drift(self, nid, memo=None, stack=()):
        """Largest number of leads on any lineage chain ending at nid."""
        memo = {} if memo is None else memo
        if nid in memo:
            return memo[nid]
        best = 0
        for p in self.lineage_parents(nid):
            if p in self.nodes and p not in stack:
                best = max(best, self.drift(p, memo, stack + (nid,)))
        memo[nid] = best + (1 if self.type(nid) == "lead" else 0)
        return memo[nid]

    def lineage_leads(self, nid):
        seen, stack, leads = set(), [nid], []
        while stack:
            x = stack.pop()
            for p in self.lineage_parents(x):
                if p in self.nodes and p not in seen:
                    seen.add(p)
                    if self.type(p) == "lead":
                        leads.append(p)
                    stack.append(p)
        return sorted(leads)

    def retro(self, nid):
        """Does this node rest on a retrospective experiment?"""
        t = self.type(nid)
        if t == "experiment":
            return bool(self.nodes[nid].get("retrospective"))
        if t == "result":
            p = self.producer(nid)
            return bool(p and self.retro(p))
        if t == "conclusion":
            return any(self.retro(r) for r in self.out(nid, "derived-from") if r in self.nodes)
        return False

    def experiment_basis(self, cid, valid_only=True):
        """derived-from results of conclusion cid produced by an experiment."""
        out = []
        for r in self.out(cid, "derived-from"):
            if r in self.nodes and self.type(self.producer(r)) == "experiment":
                if not valid_only or self.status(r) == "valid":
                    out.append(r)
        return out

    # -- verdicts and derived statuses

    def predicted(self, e):
        return [p["hypothesis"] for p in self.nodes[e].get("predictions") or [] if isinstance(p, dict)]

    def interim(self, rid):
        return bool(self.nodes[rid].get("interim"))

    def final(self, rid):
        """A valid, non-interim result: the kind that gets verdicts and reviews."""
        return self.type(rid) == "result" and self.status(rid) == "valid" and not self.interim(rid)

    def current_verdicts(self, e):
        """{hypothesis: verdict entry}: the last entry per hypothesis whose result is still valid."""
        cur = {}
        for v in self.nodes[e].get("verdicts") or []:
            if isinstance(v, dict) and self.status(v.get("result")) == "valid":
                cur[v.get("hypothesis")] = v
        return cur

    def missing_verdicts(self, e):
        cur = self.current_verdicts(e)
        return [h for h in self.predicted(e) if h not in cur]

    def verdicts_on(self, rid):
        """Verdict entries judged on result rid, with whether each is still current."""
        e = self.producer(rid)
        if self.type(e) != "experiment":
            return []
        cur = self.current_verdicts(e)
        return [dict(v, current=cur.get(v["hypothesis"]) is v) for v in self.nodes[e]["verdicts"]
                if isinstance(v, dict) and v.get("result") == rid]

    def hyp_events(self, h):
        """The votes on hypothesis h as (sort key, status, source): one per experiment with a
        current verdict on it. The order (experiment id) is only for display; the status does not
        depend on it or on when a verdict was written.

        Legacy: `nb confirm --also` used to let a conclusion set a hypothesis's status, stored as
        a `confirm-also` entry in h's log. nb no longer writes these, but each entry already in a
        notebook still counts as one vote.
        """
        events = []
        for e in sorted(self.into(h, "tests")):
            if self.type(e) != "experiment":
                continue
            v = self.current_verdicts(e).get(h)
            if v:
                events.append(((0, e, 0), VERDICT_STATUS.get(v.get("verdict"), "open"), e))
        for i, entry in enumerate(self.nodes[h]["log"]):
            if isinstance(entry, dict) and entry.get("event") == "confirm-also" and entry.get("to") in ("supported", "refuted"):
                events.append(((1, "", i), entry["to"], "%s (legacy confirm --also)" % entry.get("reason", "a conclusion")))
        return events

    def hyp_tally(self, h):
        """{'supported': [sources], 'refuted': [...], 'inconclusive': [...]} over h's votes."""
        tally = {"supported": [], "refuted": [], "inconclusive": []}
        for _, st, src in self.hyp_events(h):
            tally["inconclusive" if st == "open" else st].append(src)
        return tally

    def hyp_verdict(self, h):
        """(status, reason) from the set of votes, whatever their order; (None, ...) with no votes.

        Any supported and no refuted -> supported; any refuted and no supported -> refuted; both
        -> contested; only inconclusive -> open.
        """
        t = self.hyp_tally(h)
        if not any(t.values()):
            return None, "no current verdict"
        st = ("contested" if t["supported"] and t["refuted"] else "supported" if t["supported"]
              else "refuted" if t["refuted"] else "open")
        return st, "; ".join("%s: %s" % (k, ", ".join(v)) for k, v in t.items() if v)

    def derive_hyp(self, h):
        """The derived status, or None for a hypothesis with no votes (left as it is)."""
        if self.status(h) == "superseded":
            return "superseded"
        return self.hyp_verdict(h)[0]

    def migrate_hyp_status(self):
        """Schema 1 -> 2: hypothesis status comes from the set of verdicts, not the most recent."""
        for h in sorted(k for k, n in self.nodes.items() if n.get("type") == "hypothesis"):
            new, why = self.hyp_verdict(h)
            if new and self.status(h) != "superseded" and new != self.status(h):
                self.set_status(h, new, "migrate", reason="schema 2: " + why)

    def recompute(self, hyps=(), exps=(), event="verdict", reopen=False, force=False):
        """Bring derived statuses up to date; returns change lines ('hyp-x open -> refuted').

        hyps: hypotheses whose events changed (no events left -> open when force).
        exps: experiments to check for done; with reopen, a done one missing a verdict goes back
        to frozen.
        """
        changes = []
        for h in sorted(set(hyps)):
            if h not in self.nodes or self.status(h) == "superseded":
                continue
            new, why = self.hyp_verdict(h)
            new = new or ("open" if force else None)
            if new and new != self.status(h):
                changes.append("%s %s -> %s" % (h, self.status(h), new))
                self.set_status(h, new, event, reason=why)
        for e in sorted(set(exps)):
            if self.type(e) != "experiment":
                continue
            st, missing = self.status(e), self.missing_verdicts(e)
            if st == "frozen" and self.predicted(e) and not missing:
                changes.append("%s frozen -> done" % e)
                self.set_status(e, "done", event, reason="every predicted hypothesis has a verdict")
            elif st == "done" and reopen and missing and self.nodes[e].get("verdicts"):
                changes.append("%s done -> frozen" % e)
                self.set_status(e, "frozen", event, reason="no current verdict for %s" % ", ".join(missing))
        return changes

    # -- review

    def review_state(self, rid):
        """'interim', 'unreviewed', 'pending: <id>', 'nothing yet' or 'reviewed: <id>'."""
        n = self.nodes[rid]
        if n.get("interim"):
            return "interim"
        reviews = [r for r in n.get("reviews") or [] if isinstance(r, dict)]
        if reviews:
            last = reviews[-1]
            return "reviewed: nothing yet" if last.get("kind") == "nothing-yet" else "reviewed: %s" % last.get("by", "?")
        drafts = sorted(c for c in self.into(rid, "derived-from", "suggested-by") if self.status(c) == "pending")
        return "pending: %s" % ", ".join(drafts) if drafts else "unreviewed"

    def unreviewed(self):
        return sorted((k for k, n in self.nodes.items() if self.final(k) and not n.get("reviews")),
                      key=lambda k: (self.nodes[k]["created"], k))

    def add_review(self, rid, kind, by=None, note=None):
        entry = {"date": today(), "author": author(), "kind": kind}
        if by:
            entry["by"] = by
        if note:
            entry["note"] = note
        self.nodes[rid]["reviews"].append(entry)
        self.touch(self.nodes[rid], "review", to=kind if not by else "%s %s" % (kind, by))

    # -- closing the loop

    def verdicts_missing(self):
        """Frozen experiments with a final result and a predicted hypothesis without a current verdict."""
        out = []
        for k, n in self.nodes.items():
            if n["type"] == "experiment" and n.get("status") == "frozen" and self.missing_verdicts(k) \
                    and any(self.final(r) for r in self.out(k, "produces")):
                out.append(k)
        return sorted(out, key=lambda k: (self.nodes[k]["created"], k))

    def stale_interim(self):
        """Frozen experiments/explorations whose only results are interim, the newest older than pending_days."""
        out = []
        for k, n in self.nodes.items():
            if n["type"] not in ("experiment", "exploration") or n.get("status") != "frozen":
                continue
            res = [r for r in self.out(k, "produces") if self.status(r) == "valid"]
            if res and all(self.interim(r) for r in res):
                newest = max(self.nodes[r]["created"] for r in res)
                if age_days(newest) > self.config("pending_days"):
                    out.append(k)
        return sorted(out, key=lambda k: (self.nodes[k]["created"], k))

    def gate_blockers(self):
        """[(id, why)] that block nb freeze while freeze_gate is on."""
        out = []
        for e in self.verdicts_missing():
            out.append((e, "result in, no verdict for %s" % ", ".join(self.missing_verdicts(e))))
        for r in self.unreviewed():
            out.append((r, "result not reviewed (%s)" % self.review_state(r)))
        return out

    def follow_ons(self, cid):
        """[(id, new status)] that `nb confirm <cid> --also` may apply: the open questions it answers.

        A hypothesis is never a follow-on: its status follows its verdicts only.
        """
        if self.type(cid) != "conclusion":
            return []
        return [(q, "answered") for q in self.out(cid, "answers") if self.status(q) == "open"]

    # -- audits

    def commit_rank(self, sha):
        """Position of a notebook commit in history (higher is newer); -1 if unknown."""
        if self._ranks is None:
            self._ranks = {}
            if self.head:
                out = self.git.run("rev-list", "--topo-order", self.head, check=False).stdout.split()
                self._ranks = {c: len(out) - i for i, c in enumerate(out)}
        return self._ranks.get(sha, -1)

    def audits_of(self, nid):
        """Audits of nid, oldest first (by the notebook version each was made at)."""
        return sorted(self.into(nid, "audits"),
                      key=lambda a: (self.commit_rank(self.nodes[a].get("audited_at", "")), self.nodes[a]["created"], a))

    def latest_audit(self, nid):
        a = self.audits_of(nid)
        return a[-1] if a else None

    def audit_changes(self, aid, nid):
        """Fields of nid changed since audit aid was made (tags, refs, log and updated excepted).
        None if the audited version cannot be found."""
        sha = self.nodes[aid].get("audited_at")
        if not sha:
            return None
        res = self.git.run("cat-file", "blob", "%s:nodes/%s.json" % (sha, nid), check=False)
        if res.returncode != 0:
            return None
        then, now = json.loads(res.stdout), json.loads(serialise(self.nodes[nid]))
        skip = {"tags", "refs", "log", "updated"}
        return sorted(k for k in set(then) | set(now) if k not in skip and then.get(k) != now.get(k))

    def audit_current(self, aid, nid):
        return self.audit_changes(aid, nid) == []

    # -- writing helpers

    def touch(self, n, event, **kw):
        entry = {"date": today(), "author": author(), "event": event}
        entry.update({k: v for k, v in kw.items() if v not in (None, "")})
        n["log"].append(entry)
        n["updated"] = today()
        self.changed()

    def set_status(self, nid, new, event, reason=None, **extra):
        n = self.nodes[nid]
        old = n["status"]
        n["status"] = new
        self.touch(n, event, **dict({"from": old, "to": new, "reason": reason}, **extra))

    def establish(self, nid, event):
        """pending (or new) -> established, applying supersessions."""
        n = self.nodes[nid]
        t = n["type"]
        if t == "conclusion":
            check_conclusion_basis(self, nid)
            n["confirmed_at"] = self.head or ""
        if t in ESTABLISHED and n["status"] != ESTABLISHED[t]:
            self.set_status(nid, ESTABLISHED[t], event)
        for old in self.out(nid, "supersedes"):
            if self.status(old) != "superseded":
                self.set_status(old, "superseded", "superseded", reason="by %s" % nid)
        if t in ("conclusion", "lead"):
            # Establishing a claim reviews every result it rests on (SPEC: Review).
            for r in self.out(nid, "derived-from", "suggested-by"):
                if self.type(r) == "result":
                    self.add_review(r, "confirmed", by=nid)

    def add_link(self, nid, rel, to):
        n = self.nodes[nid]
        if any(l["rel"] == rel and l["to"] == to for l in n["links"]):
            raise NbError("%s already %s %s" % (nid, rel, to))
        n["links"].append({"rel": rel, "to": to})
        self.changed()


def check_conclusion_basis(g, cid):
    if not g.experiment_basis(cid):
        raise NbError("%s must derive from at least one valid result of an experiment "
                      "(results of explorations can only suggest leads)" % cid)


# ----------------------------------------------------------- validation ---

def validate(g):
    """Structural errors as (id, message). Writes refuse to add new ones."""
    errs = []
    nodes = g.nodes
    for nid in sorted(nodes):
        n = nodes[nid]
        e = lambda msg: errs.append((nid, msg))
        t = n.get("type")
        if t not in TYPE_FIELDS:
            e("unknown type %r" % t)
            continue
        if not ID_RE.match(nid) or TYPE_OF_PREFIX.get(nid.split("-")[0]) != t or n.get("id") != nid:
            e("bad id for a %s" % t)
        fields = fields_of(t)
        for k, v in n.items():
            if k not in fields:
                e("unknown field %r" % k)
            elif not isinstance(v, fields[k]):
                e("%s should be %s" % (k, fields[k].__name__))
            elif k in ENUMS and v and v not in ENUMS[k]:
                e("%s must be one of %s" % (k, ", ".join(sorted(ENUMS[k]))))
        for k in ["title", "author", "created", "updated"] + REQUIRED.get(t, []):
            if not n.get(k):
                e("missing %s" % k)
        for k in ("created", "updated"):
            if n.get(k) and not DATE_RE.match(str(n[k])):
                e("%s is not YYYY-MM-DD" % k)
        if t == "audit":
            if n.get("status"):
                e("audits have no status")
        elif n.get("status") not in STATUSES[t]:
            e("status %r is not one of %s" % (n.get("status"), ", ".join(STATUSES[t])))
        for k in ("refs", "tags", "rejected"):
            v = n.get(k) or []
            if isinstance(v, list) and (any(not isinstance(x, str) or not x for x in v) or len(set(v)) != len(v)):
                e("%s has empty, non-string or duplicate items" % k)
        for entry in n.get("log") or []:
            if not isinstance(entry, dict) or not all(entry.get(k) for k in ("date", "author", "event")):
                e("log entry without date, author and event")
                break
        seen = set()
        for l in n.get("links") or []:
            if not isinstance(l, dict) or set(l) != {"rel", "to"}:
                e("malformed link %r" % (l,))
                continue
            rel, to = l["rel"], l["to"]
            if (rel, to) in seen:
                e("duplicate link %s %s" % (rel, to))
            seen.add((rel, to))
            if rel not in EDGES:
                e("unknown relation %r" % rel)
                continue
            frm, tos = EDGES[rel]
            if to == nid:
                e("links to itself (%s)" % rel)
            elif to not in nodes:
                e("dangling link %s %s" % (rel, to))
            elif t not in frm:
                e("a %s cannot have %s links" % (t, rel))
            elif nodes[to].get("type") not in ({t} if tos == SAME else tos):
                e("%s cannot point at a %s (%s)" % (rel, nodes[to].get("type"), to))
        if t in REQUIRED_LINKS:
            rel, lo, hi = REQUIRED_LINKS[t]
            k = sum(1 for l in n.get("links") or [] if isinstance(l, dict) and l.get("rel") == rel)
            if k < lo or (hi and k > hi):
                e("needs %s %s link%s" % ("exactly %d" % lo if hi == lo else "at least %d" % lo, rel, "" if lo == 1 else "s"))
        if t in ("experiment", "exploration"):
            st = n.get("status")
            if t == "experiment":
                preds = n.get("predictions") or []
                bad = [p for p in preds if not isinstance(p, dict) or set(p) != set(PREDICTION_KEYS)]
                if bad:
                    e("predictions need exactly the keys %s" % ", ".join(PREDICTION_KEYS))
                ph = sorted(p.get("hypothesis") for p in preds if isinstance(p, dict))
                th = sorted(l["to"] for l in n.get("links") or [] if isinstance(l, dict) and l.get("rel") == "tests")
                if ph != th:
                    e("predictions and tests links disagree")
            if t == "experiment":
                produced = set(l["to"] for l in n.get("links") or [] if isinstance(l, dict) and l.get("rel") == "produces")
                for v in n.get("verdicts") or []:
                    if not isinstance(v, dict) or not VERDICT_KEYS <= set(v) or set(v) - VERDICT_KEYS - VERDICT_OPTIONAL \
                            or not all(v.get(k) for k in VERDICT_KEYS):
                        e("verdicts need the keys %s (and optionally %s)"
                          % (", ".join(sorted(VERDICT_KEYS)), ", ".join(sorted(VERDICT_OPTIONAL))))
                        break
                    if v["verdict"] not in VERDICTS:
                        e("verdict %r is not one of %s" % (v["verdict"], ", ".join(VERDICTS)))
                    if v["hypothesis"] not in ph:
                        e("verdict for %s, which this experiment does not predict" % v["hypothesis"])
                    if v["result"] not in produced:
                        e("verdict judged on %s, which this experiment did not produce" % v["result"])
                    elif nodes.get(v["result"], {}).get("interim"):
                        e("verdict judged on interim result %s" % v["result"])
                    if v.get("at") and not AT_RE.match(str(v["at"])):
                        e("verdict at %r is not YYYY-MM-DDTHH:MM:SSZ" % v["at"])
                    if v.get("replaces") and not v.get("reason"):
                        e("a replacement verdict needs a reason")
            if st in ("frozen", "done") or n.get("spec_hash"):
                if not n.get("spec_hash"):
                    e("%s but never frozen" % st)
                elif n["spec_hash"] != spec_hash(n):
                    e("frozen spec was changed (spec_hash mismatch)")
        if t == "result":
            prods = [f for r, f in g.inbound.get(nid, []) if r == "produces"]
            if len(prods) != 1:
                e("must be produced by exactly one experiment or exploration (has %d)" % len(prods))
            elif nodes[prods[0]].get("status") == "draft":
                e("produced by %s, which was never frozen" % prods[0])
            for rv in n.get("reviews") or []:
                if not isinstance(rv, dict) or not REVIEW_KEYS <= set(rv) or set(rv) - REVIEW_KEYS - REVIEW_OPTIONAL \
                        or rv.get("kind") not in REVIEW_KINDS or (rv.get("kind") == "confirmed" and not rv.get("by")):
                    e("reviews need date, author and kind (%s); a confirmed review needs by"
                      % ", ".join(sorted(REVIEW_KINDS)))
                    break
        if t == "conclusion" and n.get("links") and not g.experiment_basis(nid, valid_only=False):
            e("derives only from exploration results; exploration results can only suggest leads")
    for rel in ACYCLIC:
        cyc = find_cycle(g, rel)
        if cyc:
            errs.append((cyc[0], "cycle in %s: %s" % (rel, " -> ".join(cyc))))
    return errs


def find_cycle(g, rel):
    state = {}

    def visit(x, trail):
        state[x] = 1
        for y in g.out(x, rel):
            if y not in g.nodes:
                continue
            if state.get(y) == 1:
                return trail[trail.index(y):] + [y]
            if not state.get(y):
                found = visit(y, trail + [y])
                if found:
                    return found
        state[x] = 2
        return None

    for nid in sorted(g.nodes):
        if not state.get(nid):
            found = visit(nid, [nid])
            if found:
                return found
    return None


# ---------------------------------------------------------------- store ---

def build_tree(g):
    entries = []
    for nid, n in g.nodes.items():
        text = serialise(n)
        cached = g.blobs.get(nid)
        sha = cached[1] if cached and cached[0] == text else g.git.hash_blob(text)
        entries.append(("100644", "blob", sha, nid + ".json"))
    root = [("100644", "blob", g.git.hash_blob(json.dumps(g.meta, indent=2, sort_keys=True) + "\n"), "meta.json")]
    if entries:
        root.append(("040000", "tree", g.git.mktree(entries), "nodes"))
    return g.git.mktree(root)


def write(message, apply, required=True):
    """load -> apply -> refuse new validation errors -> commit -> compare-and-swap, retrying."""
    git = Git(repo_root())
    for attempt in range(RETRIES):
        if attempt:
            time.sleep(random.uniform(0.01, 0.05) * min(attempt, 8))  # jitter so racing writers spread out
        g = Graph.load(git, required=required)
        before = set(validate(g))
        out = apply(g)
        g.changed()
        new = [e for e in validate(g) if e not in before]
        if new:
            raise NbError("refused, the notebook would be invalid:\n  " +
                          "\n  ".join("%s: %s" % e for e in new))
        msg = message(out) if callable(message) else message
        commit = git.commit_tree(build_tree(g), [g.head] if g.head else [], msg)
        if git.swap(ref_name(), commit, g.head):
            return out
    raise NbError("the notebook ref kept moving under this write; try again")


def read():
    git = Git(repo_root())
    return Graph.load(git)


# --------------------------------------------------------------- output ---

def emit(obj, as_json, lines):
    if as_json:
        print(json.dumps(obj, indent=2, ensure_ascii=False))
    else:
        for line in lines:
            print(line)


def short(s, n=90):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[:n - 1] + "…"


def row(g, nid, width=90):
    n = g.nodes[nid]
    marks = (" [retro]" if g.retro(nid) else "")
    return "%-10s %-11s %-11s %s%s" % (nid, n["type"], n.get("status") or n.get("verdict", ""), short(n["title"], width), marks)


def node_brief(g, nid):
    n = g.nodes[nid]
    return {"id": nid, "type": n["type"], "status": n.get("status", ""), "title": n["title"],
            "author": n["author"], "created": n["created"]}


def say(line):
    """Human-readable detail on stderr, so stdout stays just the id for $(nb ...)."""
    print(line, file=sys.stderr)


def read_body(value):
    return sys.stdin.read().strip() if value == "-" else value


# ---------------------------------------------------------- write cmds ---

TYPE_FLAGS = {
    "goal": [], "question": [],
    "hypothesis": ["prediction"],
    "experiment": ["spec", "execution", "retro", "fresh"],
    "exploration": ["spec", "execution", "fresh"],
    "conclusion": ["rationale", "scope", "alternatives", "confidence", "from_", "origin", "user_words"],
    "lead": ["rationale", "from_", "origin", "user_words"],
    "decision": ["rationale", "reject", "revisit_if"],
    "audit": ["of", "verdict", "findings", "auditor"],
}
ALL_FLAGS = sorted({f for fs in TYPE_FLAGS.values() for f in fs})


def parse_link(g, spec):
    if ":" not in spec:
        raise NbError("--link takes REL:ID, got %r" % spec)
    rel, term = spec.split(":", 1)
    if rel not in EDGES:
        raise NbError("unknown relation %r (one of %s)" % (rel, ", ".join(sorted(EDGES))))
    return rel, g.resolve(term)


def cmd_init(args):
    root = repo_root()
    git = Git(root)
    has_origin = git.ok("remote", "get-url", "origin")
    state = "already exists"
    if not git.rev(ref_name()) and has_origin:
        # A fresh clone: adopt origin's notebook rather than starting a second history.
        if git.ok("fetch", "-q", "origin", "+%s:%s" % (ref_name(), ORIGIN_REF)) and git.rev(ORIGIN_REF):
            git.swap(ref_name(), git.rev(ORIGIN_REF), None)
            state = "fetched from origin"
    if not git.rev(ref_name()):
        write("nb: init", lambda g: None, required=False)
        state = "created"
    print("notebook %s at %s" % (state, ref_name()))
    if has_origin:
        spec = "+%s:%s" % (ref_name(), ORIGIN_REF)
        have = git.run("config", "--get-all", "remote.origin.fetch", check=False).stdout.split()
        if spec not in have:
            git.run("config", "--add", "remote.origin.fetch", spec)
            print("added fetch refspec %s" % spec)
        hook = Path(git.run("rev-parse", "--git-path", "hooks/pre-push").stdout.strip())
        if not hook.is_absolute():
            hook = root / hook
        install_pre_push(hook)


HOOK_BEGIN, HOOK_END = "# >>> nb sync >>>", "# <<< nb sync <<<"


def install_pre_push(hook):
    text = hook.read_text() if hook.exists() else "#!/bin/sh\n"
    if HOOK_BEGIN in text:
        return
    nb = Path(__file__).resolve()
    block = "\n".join([
        HOOK_BEGIN,
        "# Added by `nb init`: sync the lab notebook ref; never blocks the push.",
        'if [ -z "$NB_IN_HOOK" ]; then',
        '  NB=$(command -v nb || echo "%s")' % nb,
        '  [ -x "$NB" ] && { NB_IN_HOOK=1 "$NB" sync --quiet || echo "nb: notebook sync failed (push continues)" >&2; }',
        "fi",
        HOOK_END, ""])
    hook.parent.mkdir(parents=True, exist_ok=True)
    # Insert before a trailing `exit` of an existing hook so the block still runs.
    lines = text.rstrip("\n").split("\n")
    if lines and re.match(r"^\s*exit\b", lines[-1]):
        text = "\n".join(lines[:-1]) + "\n" + block + lines[-1] + "\n"
    else:
        text = text.rstrip("\n") + "\n" + block
    hook.write_text(text)
    hook.chmod(0o755)
    print("added notebook sync to %s" % hook)


def cmd_add(args):
    t = args.type
    given = [f for f in ALL_FLAGS if getattr(args, f) not in (None, False, [])]
    stray = [f for f in given if f not in TYPE_FLAGS[t]]
    if stray:
        raise NbError("a %s does not take %s" % (t, ", ".join("--" + f.rstrip("_").replace("_", "-") for f in stray)))

    def apply(g):
        nid = g.new_id(t)
        who = author()
        n = {k: default(kind) for k, kind in fields_of(t).items()}
        n.update(id=nid, type=t, title=args.title.strip(), author=who, created=today(), updated=today(),
                 body=read_body(args.body or ""), refs=args.ref or [], tags=args.tag or [])
        if t == "audit":
            n["status"] = ""
        elif t in ESTABLISHED:
            n["status"] = "pending"
        else:
            n["status"] = STATUSES[t][0]
        for f in ("prediction", "spec", "execution", "rationale", "scope", "alternatives",
                  "confidence", "verdict", "findings", "auditor", "revisit_if", "origin", "user_words"):
            if getattr(args, f, None):
                n[f] = read_body(getattr(args, f)) if f in ("spec", "rationale", "user_words") else getattr(args, f)
        if t in ("conclusion", "lead") and who == "claude" and not n["origin"]:
            raise NbError("a %s drafted by Claude needs --origin user (drafted from the user's read, with "
                          "--user-words) or --origin claude (Claude's read, given because the user asked)" % t)
        if n.get("origin") == "user" and not n["user_words"]:
            raise NbError("--origin user needs --user-words: the user's read, verbatim")
        if args.fresh:
            n["fresh"] = True
        if args.retro:
            n["retrospective"] = True
        if args.reject:
            n["rejected"] = args.reject
        g.nodes[nid] = n
        for spec in args.link or []:
            rel, to = parse_link(g, spec)
            if rel in ("produces", "tests"):
                raise NbError("%s links are made by `nb %s`" % (rel, "result" if rel == "produces" else "predict"))
            g.add_link(nid, rel, to)
        for r in args.from_ or []:
            g.add_link(nid, "derived-from" if t == "conclusion" else "suggested-by", g.resolve(r))
        if args.of:
            g.add_link(nid, "audits", g.resolve(args.of, {"conclusion", "lead"}))
            n["audited_at"] = g.head or ""
            n["auditor"] = n["auditor"] or who
        if t == "conclusion":
            check_conclusion_basis(g, nid)
        g.touch(n, "add", to=n["status"] or None)
        if t == "hypothesis" or (t in ESTABLISHED and who == "user"):
            g.establish(nid, "add")
        return nid

    nid = write(lambda nid: "nb: add %s" % nid, apply)
    print(nid)
    say("added %s %s: %s" % (t, nid, args.title.strip()))


def cmd_predict(args):
    def apply(g):
        e = g.resolve(args.experiment, {"experiment"})
        h = g.resolve(args.hypothesis, {"hypothesis"})
        n = g.nodes[e]
        if n["status"] != "draft":
            raise NbError("%s is %s; predictions can only be added to a draft" % (e, n["status"]))
        if any(p["hypothesis"] == h for p in n["predictions"]):
            raise NbError("%s already has a prediction for %s" % (e, h))
        n["predictions"].append({"hypothesis": h, "prediction": args.prediction,
                                 "metric": args.metric, "decision_rule": args.rule})
        g.add_link(e, "tests", h)
        g.touch(n, "predict", to=h)
        return e, h

    e, h = write(lambda r: "nb: predict %s %s" % r, apply)
    print("%s tests %s" % (e, h))


def check_link_allowed(g, nid, rel):
    n = g.nodes[nid]
    t = n["type"]
    if t == "audit":
        raise NbError("audits are immutable")
    if rel == "produces":
        raise NbError("produces links are made by `nb result`")
    if rel == "tests":
        raise NbError("tests links are made by `nb predict`")
    if t == "result" and rel not in ("supports", "contradicts"):
        raise NbError("a result can only gain supports or contradicts links")
    if rel in ("derived-from", "supersedes") and n["status"] != "pending":
        raise NbError("%s links are the basis of %s and cannot change once it is %s"
                      % (rel, nid, n["status"]))


def cmd_link(args):
    def apply(g):
        a, b = g.resolve(args.source), g.resolve(args.target)
        check_link_allowed(g, a, args.rel)
        if args.rel not in EDGES:
            raise NbError("unknown relation %r" % args.rel)
        g.add_link(a, args.rel, b)
        g.touch(g.nodes[a], "link", to="%s %s" % (args.rel, b))
        return a, args.rel, b

    print("%s %s %s" % write(lambda r: "nb: link %s %s %s" % r, apply))


def cmd_unlink(args):
    def apply(g):
        a, b = g.resolve(args.source), g.resolve(args.target)
        n = g.nodes[a]
        if n["type"] in ("result", "audit") or n.get("status") not in INITIAL:
            raise NbError("%s is %s; links can only be removed while a node is draft, open or pending"
                          % (a, n.get("status") or n["type"]))
        if args.rel == "produces":
            raise NbError("produces links cannot be removed")
        before = len(n["links"])
        n["links"] = [l for l in n["links"] if not (l["rel"] == args.rel and l["to"] == b)]
        if len(n["links"]) == before:
            raise NbError("%s has no %s link to %s" % (a, args.rel, b))
        if args.rel == "tests":
            n["predictions"] = [p for p in n["predictions"] if p["hypothesis"] != b]
        g.touch(n, "unlink", to="%s %s" % (args.rel, b))
        return a, args.rel, b

    print("removed %s %s %s" % write(lambda r: "nb: unlink %s %s %s" % r, apply))


def cmd_set(args):
    def apply(g):
        nid = g.resolve(args.id)
        n = g.nodes[nid]
        t, f = n["type"], args.field
        fields = fields_of(t)
        if f not in fields or f in SYSTEM_FIELDS:
            raise NbError("%s is not a field `nb set` can change on a %s" % (f, t))
        if f != "tags":
            if t in ("audit", "result"):
                raise NbError("a %s cannot change, except its tags" % t)
            if f not in ("body", "refs"):
                if n["status"] not in INITIAL:
                    raise NbError("%s is %s; only body, refs and tags can change now" % (nid, n["status"]))
                if t == "hypothesis" and any(g.status(e) != "draft" for e in g.into(nid, "tests")):
                    raise NbError("%s is tested by a frozen experiment; supersede it instead" % nid)
        kind = fields[f]
        value = read_body(args.value)
        if kind is list:
            cur = list(n[f])
            if args.remove:
                if value not in cur:
                    raise NbError("%s has no %s %r" % (nid, f, value))
                cur.remove(value)
            elif args.append:
                cur.append(value)
            else:
                cur = [value]
            n[f] = cur
        elif args.append or args.remove:
            raise NbError("--append and --remove are for list fields")
        elif kind is bool:
            if value not in ("true", "false"):
                raise NbError("%s takes true or false" % f)
            n[f] = value == "true"
        else:
            n[f] = value
        g.touch(n, "set", field=f)
        return nid, f

    print("set %s %s" % write(lambda r: "nb: set %s %s" % r, apply))


def reason_required(t, cur, new):
    return (new in ("abandoned", "parked", "dropped", "rejected")
            or (t == "conclusion" and new == "refuted")
            or (t == "question" and new == "open")
            or (t == "hypothesis" and new == "superseded"))


def cmd_status(args):
    def apply(g):
        nid = g.resolve(args.id)
        n = g.nodes[nid]
        t, cur, new = n["type"], n.get("status"), args.status
        if new not in STATUSES.get(t, []):
            raise NbError("a %s has no status %r" % (t, new))
        if new not in STATUS_MOVES.get(t, {}).get(cur, set()):
            hint = {"frozen": "nb freeze", "pending": "", "superseded": "add a node that supersedes it"}.get(new, "")
            if cur == "pending":
                hint = "nb confirm or nb reject"
            elif t == "result":
                hint = "nb invalidate"
            elif t == "hypothesis":
                hint = "nb result --verdict or nb verdict; a hypothesis follows its verdicts"
            elif t == "experiment" and new == "done":
                hint = "nb result --verdict or nb verdict; an experiment is done once every predicted hypothesis has one"
            raise NbError("%s cannot go from %s to %s with nb status%s"
                          % (nid, cur, new, " (use %s)" % hint if hint else ""))
        if reason_required(t, cur, new) and not args.reason:
            raise NbError("moving %s to %s needs --reason" % (nid, new))
        backers = lambda rel, ty, st: [c for c in g.into(nid, rel) if g.type(c) == ty and g.status(c) == st]
        if t == "question" and new == "answered" and not backers("answers", "conclusion", "supported"):
            raise NbError("%s can be answered only when a supported conclusion answers it" % nid)
        if t == "question" and new == "settled" and not backers("affects", "decision", "active"):
            raise NbError("%s can be settled only when an active decision affects it" % nid)
        if t in ("experiment", "exploration") and new == "done" and not g.out(nid, "produces"):
            raise NbError("%s has no results yet (nb result)" % nid)
        if t == "lead" and new == "followed" and not g.out(nid, "raises", "spawns"):
            raise NbError("%s is followed once it raises a question or spawns a hypothesis or experiment" % nid)
        g.set_status(nid, new, "status", reason=args.reason)
        return nid, new

    print("%s %s" % write(lambda r: "nb: status %s %s" % r, apply))


def cmd_freeze(args):
    def apply(g):
        nid = g.resolve(args.id, {"experiment", "exploration"})
        n = g.nodes[nid]
        if n["status"] != "draft":
            raise NbError("%s is %s, not draft" % (nid, n["status"]))
        missing = [f for f in ("spec", "execution") if not n[f]]
        if n["type"] == "experiment" and not n["predictions"]:
            missing.append("a prediction (nb predict)")
        if n["type"] == "experiment" and any(not all(p.get(k) for k in PREDICTION_KEYS) for p in n["predictions"]):
            missing.append("complete predictions")
        if missing:
            raise NbError("%s cannot be frozen without %s" % (nid, ", ".join(missing)))
        if not g.has_active_goal(nid):
            raise NbError("%s has no path to an active goal (nb path %s)" % (nid, nid))
        if not g.out(nid, "variant-of", "uses") and not n.get("fresh"):
            raise NbError("%s does not say what it builds on: add --link variant-of:<exp> (it changes an earlier "
                          "design) or uses:<exp, xpl or res> (it uses its outputs or analyses a result) with "
                          "nb link, or mark it fresh (nb set %s fresh true) if it builds on nothing in the notebook"
                          % (nid, nid))
        if g.config("freeze_gate"):
            blockers = g.gate_blockers()
            if blockers:
                raise NbError("the freeze gate is closed; close these first (nb gate):\n  "
                              + "\n  ".join(gate_line(g, k, why) for k, why in blockers))
        n["spec_hash"] = spec_hash(n)
        n["frozen_at"] = g.head or ""
        g.set_status(nid, "frozen", "freeze")
        return nid, n["title"]

    nid, title = write(lambda r: "nb: freeze %s" % r[0], apply)
    print(nid)
    say("frozen %s: %s" % (nid, title))


def gate_line(g, k, why):
    return "%-10s %s   %s" % (k, short(g.nodes[k]["title"], 60), why)


def cmd_deviate(args):
    def apply(g):
        nid = g.resolve(args.id, {"experiment", "exploration"})
        n = g.nodes[nid]
        if n["status"] not in ("frozen", "done"):
            raise NbError("%s is %s; deviations are recorded on frozen specs (edit a draft directly)" % (nid, n["status"]))
        n["deviations"].append({"date": today(), "author": author(), "text": read_body(args.text)})
        g.touch(n, "deviate")
        return nid

    print("deviation recorded on %s" % write(lambda nid: "nb: deviate %s" % nid, apply))


def provenance(git, root, args):
    p = {}
    commit = args.commit or (git.rev("HEAD") if git.ok("rev-parse", "--verify", "-q", "HEAD") else None)
    if commit:
        p["commit"] = git.rev(commit) or commit  # keep as given when it does not resolve here
    if not args.commit and commit:
        p["dirty"] = bool(git.run("status", "--porcelain", "--untracked-files=no").stdout.strip())
    cwd = os.path.relpath(os.getcwd(), root)
    if cwd != ".":
        p["cwd"] = cwd
    if args.run_dir:
        p["run_dir"] = args.run_dir
    if args.ext_id:
        p["external_ids"] = args.ext_id
    if args.artifact:
        p["artifacts"] = list(args.artifact)
    return p


def cmd_result(args):
    root = repo_root()
    git = Git(root)
    metrics = None
    if args.metrics:
        try:
            metrics = json.loads(Path(args.metrics).read_text())
        except (OSError, ValueError) as e:
            raise NbError("cannot read metrics from %s: %s" % (args.metrics, e))
        if not isinstance(metrics, dict):
            raise NbError("--metrics must hold a JSON object")
    prov = provenance(git, root, args)
    if args.metrics:
        rel = os.path.relpath(os.path.abspath(args.metrics), root)
        prov.setdefault("artifacts", [])
        if rel not in prov["artifacts"]:
            prov["artifacts"].append(rel)

    def apply(g):
        e = g.resolve(args.experiment, {"experiment", "exploration"})
        if g.status(e) != "frozen":
            raise NbError("%s is %s; results attach only to a frozen experiment or exploration%s"
                          % (e, g.status(e), " (a rerun is a new experiment, --link variant-of:%s)" % e
                             if g.status(e) == "done" else ""))
        if args.verdict and args.interim:
            raise NbError("an interim result carries no verdicts; record them with the final result")
        if args.verdict and g.type(e) != "experiment":
            raise NbError("%s is an exploration; explorations have no verdicts" % e)
        rid = g.new_id("result")
        n = {k: default(kind) for k, kind in fields_of("result").items()}
        n.update(id=rid, type="result", title=short(args.summary, 100), summary=args.summary,
                 author=author(), created=today(), updated=today(), status="valid",
                 provenance=prov, metrics=metrics or {}, tags=args.tag or [], interim=bool(args.interim))
        g.nodes[rid] = n
        for spec in args.link or []:
            rel, to = parse_link(g, spec)
            if rel not in ("supports", "contradicts"):
                raise NbError("a result can only have supports or contradicts links")
            g.add_link(rid, rel, to)
        g.touch(n, "add", to="valid")
        g.add_link(e, "produces", rid)
        g.touch(g.nodes[e], "result", to=rid)
        seen, applied = set(), []
        for hyp, verdict, basis in args.verdict or []:
            h = add_verdict(g, e, rid, hyp, verdict, basis)
            if h in seen:
                raise NbError("two --verdict for %s in one result" % h)
            seen.add(h)
            applied.append("verdict %s %s: %s%s" % (h, verdict, basis, " [retro]" if g.retro(e) else ""))
        changes = g.recompute(seen, [e]) if seen else []
        return rid, n["title"], applied, changes

    rid, title, applied, changes = write(lambda r: "nb: result %s" % r[0], apply)
    print(rid)
    say("added result %s: %s" % (rid, title))
    for line in applied + changes:
        say(line)


def add_verdict(g, e, rid, hyp, verdict, basis, replace=False, reason=None):
    """Append one verdict entry to experiment e (validated); returns the hypothesis id."""
    h = g.resolve(hyp, {"hypothesis"})
    if h not in g.predicted(e):
        raise NbError("%s does not predict %s; only predicted hypotheses get verdicts (predicted: %s)"
                      % (e, h, ", ".join(g.predicted(e)) or "none"))
    if verdict not in VERDICTS:
        raise NbError("verdict must be one of %s, got %r" % (", ".join(VERDICTS), verdict))
    if not (basis or "").strip():
        raise NbError("a verdict needs a basis: the measured value and the bound from the rule")
    cur = g.current_verdicts(e).get(h)
    if cur and not replace:
        raise NbError("%s already has a current verdict for %s (%s on %s); a second verdict is a replacement: "
                      "nb verdict <res> %s <verdict> --basis B --replace --reason R"
                      % (e, h, cur["verdict"], cur["result"], h))
    if replace and not cur:
        raise NbError("%s has no current verdict for %s to replace; drop --replace" % (e, h))
    entry = {"hypothesis": h, "verdict": verdict, "result": rid, "basis": basis.strip(),
             "date": today(), "at": now_at(), "author": author()}
    if replace:
        entry.update(replaces=True, reason=reason)
    g.nodes[e]["verdicts"].append(entry)
    g.touch(g.nodes[e], "verdict", to="%s %s" % (h, verdict), reason=reason)
    return h


def cmd_verdict(args):
    if args.replace and not args.reason:
        raise NbError("--replace needs --reason: why the frozen rule is applied differently")
    if args.reason and not args.replace:
        raise NbError("--reason goes with --replace")

    def apply(g):
        rid = g.resolve(args.result, {"result"})
        e = g.producer(rid)
        if g.type(e) != "experiment":
            raise NbError("%s was produced by exploration %s; explorations have no verdicts" % (rid, e))
        if not g.final(rid):
            raise NbError("%s is %s; verdicts are judged only on valid, non-interim results"
                          % (rid, "interim" if g.interim(rid) else g.status(rid)))
        h = add_verdict(g, e, rid, args.hypothesis, args.verdict, args.basis, args.replace, args.reason)
        return rid, h, e, g.recompute([h], [e])

    rid, h, e, changes = write(lambda r: "nb: verdict %s %s" % (r[0], r[1]), apply)
    print("verdict %s %s on %s (%s)%s" % (h, args.verdict, rid, e, " replaces the previous one" if args.replace else ""))
    for line in changes:
        print(line)


def cmd_nothing_yet(args):
    def apply(g):
        done = []
        for term in args.results:
            rid = g.resolve(term, {"result"})
            if g.status(rid) != "valid":
                raise NbError("%s is invalidated; it needs no review" % rid)
            if g.interim(rid):
                raise NbError("%s is interim; interim results are not reviewed on their own (the final result is)" % rid)
            g.add_review(rid, "nothing-yet", note=args.note)
            done.append(rid)
        return done

    for rid in write(lambda r: "nb: nothing-yet %s" % " ".join(r), apply):
        print("reviewed %s: nothing yet" % rid)


def cmd_confirm(args):
    def apply(g):
        nid = g.resolve(args.id)
        n = g.nodes[nid]
        if n.get("status") != "pending":
            raise NbError("%s is %s, not pending" % (nid, n.get("status") or n["type"]))
        if n["type"] in ("conclusion", "lead") and n["author"] == "claude" and g.config("audit_before_confirm"):
            a = g.latest_audit(nid)
            if not a:
                raise NbError("%s has no audit; run the nb-auditor on `nb audit %s` and record it with "
                              "nb add audit --of %s (audit_before_confirm is on)" % (nid, nid, nid))
            changed = g.audit_changes(a, nid)
            if changed != []:
                raise NbError("the latest audit of %s (%s) is not current: %s; audit the draft again"
                              % (nid, a, "changed since: " + ", ".join(changed) if changed
                                 else "the audited version cannot be found"))
        offers = dict(g.follow_ons(nid))
        also = []
        for term in args.also or []:
            x = g.resolve(term)
            if x not in offers and g.type(x) == "hypothesis":
                raise NbError("%s is a hypothesis; its status follows its verdicts (nb result --verdict, "
                              "nb verdict), not a conclusion" % x)
            if x not in offers:
                raise NbError("%s is not a follow-on of %s (available: %s)"
                              % (x, nid, ", ".join("%s %s" % kv for kv in sorted(offers.items())) or "none"))
            also.append(x)
        g.establish(nid, "confirm")
        changes = []
        for x in also:
            new = offers[x]
            # The confirm-also log entry is the record of the change (a question becoming answered).
            changes.append("%s %s -> %s" % (x, g.status(x), new) if g.status(x) != new else "%s stays %s" % (x, new))
            g.set_status(x, new, "confirm-also", reason="by %s" % nid, at=now_at())
        return nid, n["status"], changes

    nid, status, changes = write(lambda r: "nb: confirm %s" % r[0], apply)
    print("confirmed %s (%s)" % (nid, status))
    for line in changes:
        print(line)


def cmd_reject(args):
    def apply(g):
        nid = g.resolve(args.id)
        n = g.nodes[nid]
        if n.get("status") != "pending":
            raise NbError("%s is %s, not pending" % (nid, n.get("status") or n["type"]))
        g.set_status(nid, REJECTED[n["type"]], "reject", reason=args.reason)
        return nid

    print("rejected %s" % write(lambda nid: "nb: reject %s" % nid, apply))


def cmd_invalidate(args):
    def apply(g):
        nid = g.resolve(args.id, {"result"})
        if g.status(nid) != "valid":
            raise NbError("%s is already %s" % (nid, g.status(nid)))
        withdrawn = [v["hypothesis"] for v in g.verdicts_on(nid)]
        g.set_status(nid, "invalidated", "invalidate", reason=args.reason)
        changes = []
        if withdrawn:
            # Its verdicts stop being current: recompute the hypotheses and the experiment.
            changes = g.recompute(withdrawn, [g.producer(nid)], event="invalidate", reopen=True, force=True)
        return nid, changes

    nid, changes = write(lambda r: "nb: invalidate %s" % r[0], apply)
    print("invalidated %s" % nid)
    for line in changes:
        print(line)


def cmd_retract(args):
    def apply(g):
        a, b = g.resolve(args.source), g.resolve(args.target)
        n = g.nodes[a]
        before = len(n["links"])
        n["links"] = [l for l in n["links"] if not (l["rel"] == args.rel and l["to"] == b)]
        if len(n["links"]) == before:
            raise NbError("%s has no %s link to %s" % (a, args.rel, b))
        g.touch(n, "retract", to="%s %s" % (args.rel, b), reason=args.reason)
        return a, args.rel, b

    print("retracted %s %s %s" % write(lambda r: "nb: retract %s %s %s" % r, apply))


def cmd_config(args):
    if args.action == "get":
        g = read()
        conf = {k: g.config(k) for k in CONFIG_DEFAULTS}
        if args.key:
            if args.key not in conf:
                raise NbError("unknown config key %r" % args.key)
            conf = {args.key: conf[args.key]}
        emit(conf, args.json, ["%s = %s" % (k, json.dumps(v)) for k, v in conf.items()])
        return
    if args.key not in CONFIG_DEFAULTS or args.value is None:
        raise NbError("usage: nb config set <key> <value>; keys: %s" % ", ".join(CONFIG_DEFAULTS))
    try:
        value = json.loads(args.value)
    except ValueError:
        value = args.value
    want = type(CONFIG_DEFAULTS[args.key])
    if not isinstance(value, want) or (isinstance(value, bool) and want is not bool):
        raise NbError("%s takes a %s" % (args.key, {"bool": "true or false"}.get(want.__name__, want.__name__)))

    def apply(g):
        g.meta["config"][args.key] = value

    write("nb: config %s" % args.key, apply)
    print("%s = %s" % (args.key, json.dumps(value)))


# ----------------------------------------------------------- read cmds ---

def cmd_show(args):
    g = read()
    nid = g.resolve(args.id)
    n = g.nodes[nid]
    inbound = [{"rel": r, "from": f} for r, f in sorted(g.inbound.get(nid, []))]
    t = n["type"]
    extra = {}
    if t == "result":
        extra["review"] = g.review_state(nid)
        extra["verdicts_on"] = g.verdicts_on(nid)
    if t == "experiment":
        extra["current_verdicts"] = g.current_verdicts(nid)
        extra["missing_verdicts"] = g.missing_verdicts(nid)
    if t in ("experiment", "exploration"):
        extra["builds_on"] = builds_on(g, nid)
    if t == "hypothesis":
        extra["verdict_tally"] = g.hyp_tally(nid)
    if t in ("conclusion", "lead"):
        a = g.latest_audit(nid)
        if a:
            extra["latest_audit"] = {"id": a, "verdict": g.nodes[a].get("verdict", ""),
                                     "findings": g.nodes[a].get("findings", ""), "current": g.audit_current(a, nid)}
        if n.get("status") == "pending":
            extra["follow_ons"] = [{"id": x, "type": g.type(x), "title": g.nodes[x]["title"], "status": g.status(x),
                                    "to": new} for x, new in g.follow_ons(nid)]
    if args.json:
        emit(dict(json.loads(serialise(n)), inbound=inbound, retro=g.retro(nid), **extra), True, [])
        return
    head = "%s  %s  %s%s" % (nid, n["type"], n.get("status") or n.get("verdict"), "  [retro]" if g.retro(nid) else "")
    lines = [head, n["title"], "by %s, created %s, updated %s" % (n["author"], n["created"], n["updated"])]
    if n.get("origin"):
        lines.append("origin: %s" % ("the user's read" if n["origin"] == "user" else "Claude's read, asked for by the user"))
    for k in fields_of(n["type"]):
        if k in ("id", "type", "title", "author", "created", "updated", "status", "links", "log", "origin", "fresh") \
                or not n.get(k):
            continue
        v = n[k]
        if k == "verdicts":
            cur = g.current_verdicts(nid)
            lines.append("verdicts:")
            for x in v:
                state = "current" if cur.get(x["hypothesis"]) is x else (
                    "withdrawn" if g.status(x["result"]) != "valid" else "replaced")
                lines.append("  %s %s %s on %s: %s  (%s, by %s%s)%s" % (
                    x["date"], x["hypothesis"], x["verdict"], x["result"], x["basis"], state, x["author"],
                    "; replaces the previous one: " + x.get("reason", "") if x.get("replaces") else "",
                    " [retro]" if n.get("retrospective") else ""))
        elif k == "predictions":
            lines.append("predictions:")
            for p in v:
                lines.append("  %s: %s | metric: %s | rule: %s" % (p["hypothesis"], p["prediction"], p["metric"], p["decision_rule"]))
        elif isinstance(v, str) and "\n" in v:
            lines.append("%s:" % k)
            lines.extend("  " + x for x in v.split("\n"))
        elif isinstance(v, list) and v and isinstance(v[0], dict):
            lines.append("%s:" % k)
            lines.extend("  " + canonical(x) for x in v)
        elif isinstance(v, (list, dict)):
            lines.append("%s: %s" % (k, canonical(v)))
        else:
            lines.append("%s: %s" % (k, v))
    if t in ("experiment", "exploration"):
        lines.append("builds on: %s" % builds_on_text(extra["builds_on"], n.get("fresh")))
    if t == "result":
        lines.append("review: %s" % extra["review"])
    if t == "experiment" and n.get("status") in ("frozen", "done") and extra["missing_verdicts"]:
        lines.append("no current verdict for: %s" % ", ".join(extra["missing_verdicts"]))
    if extra.get("latest_audit"):
        a = extra["latest_audit"]
        lines.append("latest audit: %s %s%s: %s" % (a["id"], a["verdict"], "" if a["current"] else " (stale: changed since)",
                                                    short(a["findings"], 200)))
    elif t in ("conclusion", "lead") and n.get("status") == "pending":
        lines.append("latest audit: none")
    if any((extra.get("verdict_tally") or {}).values()):
        lines.append("verdicts: " + "; ".join("%s by %s" % (k, ", ".join(v)) for k, v in extra["verdict_tally"].items() if v))
    if extra.get("follow_ons"):
        lines.append("follow-ons on confirm (nb confirm %s --also <id>):" % nid)
        lines.extend("  %s %s -> %s: %s" % (f["id"], f["status"], f["to"], short(f["title"], 60)) for f in extra["follow_ons"])
    if n["links"]:
        lines.append("links:")
        lines.extend("  %-12s -> %s" % (l["rel"], row(g, l["to"], 60) if l["to"] in g.nodes else l["to"] + " (missing)") for l in n["links"])
    if inbound:
        lines.append("incoming:")
        lines.extend("  %-12s <- %s" % (i["rel"], row(g, i["from"], 60)) for i in inbound)
    lines.append("log:")
    for entry in n["log"]:
        detail = " ".join(x for x in [entry.get("field", ""), entry.get("from", "") and "%s ->" % entry["from"],
                                       entry.get("to", "")] if x)
        lines.append("  %s %-6s %-10s %s%s" % (entry["date"], entry["author"], entry["event"], detail,
                                              "  (%s)" % entry["reason"] if entry.get("reason") else ""))
    emit(None, False, lines)


def cmd_context(args):
    g = read()
    root = g.resolve(args.id)
    seen, frontier, items = {root}, [root], []
    for depth in range(1, args.depth + 1):
        nxt = []
        for x in frontier:
            nbrs = [(l["rel"], "->", l["to"]) for l in g.nodes[x]["links"]] + \
                   [(r, "<-", f) for r, f in sorted(g.inbound.get(x, []))]
            for rel, arrow, y in nbrs:
                if y in g.nodes and y not in seen:
                    seen.add(y)
                    nxt.append(y)
                    items.append({"depth": depth, "via": x, "rel": rel, "dir": arrow, "node": node_brief(g, y)})
        frontier = nxt
    if args.json:
        emit({"node": node_brief(g, root), "neighbours": items}, True, [])
        return
    lines = [row(g, root)]
    for it in items:
        lines.append("%s%s %-12s %s" % ("  " * it["depth"], it["dir"], it["rel"], row(g, it["node"]["id"], 70)))
    emit(None, False, lines)


def cmd_path(args):
    g = read()
    nid = g.resolve(args.id)
    paths = g.paths(nid, extra=True)
    leads = g.lineage_leads(nid)
    drift = g.drift(nid) - (1 if g.type(nid) == "lead" else 0)
    if args.json:
        emit({"id": nid, "paths": paths, "goal_status": {p[-1]: g.status(p[-1]) for p in paths},
              "lineage_leads": leads, "drift": drift}, True, [])
        return
    lines = []
    if not paths:
        lines.append("%s has no path to a goal" % nid)
    for p in paths:
        lines.append(" -> ".join(p) + "  (%s)" % g.status(p[-1]))
    if leads:
        lines.append("lineage passes through %d lead%s (drift %d): %s"
                     % (len(leads), "" if len(leads) == 1 else "s", drift, ", ".join(leads)))
    emit(None, False, lines)


ORIGIN_WORDS = {"user": "from your read", "claude": "Claude's read"}


def claim_notes(g, k, stale=True):
    """['from your read', 'audit sound'] for a conclusion or lead; [] otherwise."""
    n = g.nodes[k]
    if n["type"] not in ("conclusion", "lead"):
        return []
    notes = [ORIGIN_WORDS[n["origin"]]] if n.get("origin") in ORIGIN_WORDS else []
    a = g.latest_audit(k)
    if a:
        notes.append("audit %s%s" % (g.nodes[a].get("verdict", "?"),
                                     " (stale)" if stale and n.get("status") == "pending" and not g.audit_current(a, k) else ""))
    elif n.get("status") == "pending":
        notes.append("not audited")
    return notes


def needs_closing(g):
    """[(id, note)]: unreviewed results, experiments missing verdicts, stale interim-only work; oldest first."""
    items = []
    for r in g.unreviewed():
        vs = ["%s %s" % (v["hypothesis"], v["verdict"]) for v in g.verdicts_on(r) if v["current"]]
        items.append((r, "unreviewed" + (" (%s)" % ", ".join(vs) if vs else "")))
    for e in g.verdicts_missing():
        items.append((e, "result in, verdict missing (%s)" % ", ".join(g.missing_verdicts(e))))
    for e in g.stale_interim():
        items.append((e, "only interim results, older than %d days" % g.config("pending_days")))
    return sorted(items, key=lambda x: (g.nodes[x[0]]["created"], x[0]))


def cmd_pending(args):
    g = read()
    ids = sorted((k for k, n in g.nodes.items() if n.get("status") == "pending"),
                 key=lambda k: (g.nodes[k]["created"], k), reverse=True)
    rows = [dict(node_brief(g, k), awaiting="confirm", origin=g.nodes[k].get("origin", ""),
                 notes=claim_notes(g, k)) for k in ids]
    lines = ["%s  %s" % (row(g, k), ", ".join([g.nodes[k]["author"]] + claim_notes(g, k) + [g.nodes[k]["created"]]))
             for k in ids]
    closing = needs_closing(g)
    if closing:
        lines += ["", "Needs closing (review with nb brief, then a conclusion or nb nothing-yet; or nb verdict):"]
        lines += ["%s  %s" % (row(g, k), note) for k, note in closing]
    rows += [dict(node_brief(g, k), awaiting="review" if g.type(k) == "result" else "closing", notes=[note])
             for k, note in closing]
    emit(rows, args.json, lines or ["nothing pending"])


def cmd_gate(args):
    g = read()
    on = bool(g.config("freeze_gate"))
    blockers = g.gate_blockers()
    data = {"freeze_gate": on, "blocked": on and bool(blockers),
            "blockers": [{"id": k, "type": g.type(k), "title": g.nodes[k]["title"], "why": why} for k, why in blockers]}
    if not blockers:
        lines = ["clear: nothing blocks nb freeze" + ("" if on else " (freeze_gate is off)")]
    else:
        lines = ["blocked: nb freeze is refused until these are closed:" if on else
                 "freeze_gate is off, so nb freeze is not blocked; with it on, these would block it:"]
        lines += ["  " + gate_line(g, k, why) for k, why in blockers]
    emit(data, args.json, lines)


# ---------------------------------------------------------------- brief ---

# The brief follows links only; there is no text or tag matching. A result that should appear
# and does not is a missing link (nb link).

def recent(g, ids):
    return sorted(set(ids), key=lambda k: (g.nodes[k]["created"], k), reverse=True)


def variant_chain(g, e):
    """Experiments/explorations on e's variant-of chain (both directions), in chain order."""
    comp, stack = {e}, [e]
    while stack:
        x = stack.pop()
        for y in g.out(x, "variant-of") + g.into(x, "variant-of"):
            if y in g.nodes and y not in comp:
                comp.add(y)
                stack.append(y)
    depth = {}

    def d(x, seen=()):
        if x not in depth:
            ups = [y for y in g.out(x, "variant-of") if y in comp and y not in seen]
            depth[x] = 1 + max((d(y, seen + (x,)) for y in ups), default=-1)
        return depth[x]

    return sorted(comp, key=lambda x: (d(x), g.nodes[x]["created"], x))


def results_of(g, producers):
    out = []
    for p in producers:
        out += sorted(g.out(p, "produces"), key=lambda r: (g.nodes[r]["created"], r))
    return out


def result_questions(g, rid):
    e = g.producer(rid)
    if not e:
        return []
    if g.type(e) == "exploration":
        return sorted(g.out(e, "investigates"))
    return sorted({q for h in g.out(e, "tests") for q in g.out(h, "addresses")})


def results_under(g, q):
    prods = set(g.into(q, "investigates"))
    for h in g.into(q, "addresses"):
        prods.update(g.into(h, "tests"))
    return [r for p in prods for r in g.out(p, "produces")]


def builds_on(g, e):
    """What a design builds on: [{rel, id, type, title}] for its variant-of and uses links."""
    return [{"rel": l["rel"], "id": l["to"], "type": g.type(l["to"]), "title": g.nodes[l["to"]]["title"]}
            for l in g.nodes[e]["links"] if l["rel"] in ("variant-of", "uses") and l["to"] in g.nodes]


def builds_on_text(items, fresh):
    """'variant of Run 18 (exp-x); uses Run 19 (exp-y)', 'fresh', or a warning."""
    words = {"variant-of": "variant of", "uses": "uses"}
    parts = ["%s %s %s (%s)" % (words[b["rel"]], b["type"], short(b["title"], 60), b["id"]) for b in items]
    if fresh:
        parts.append("fresh (builds on nothing in the notebook)")
    return "; ".join(parts) or "nothing stated (nb freeze needs variant-of, uses or fresh)"


def uses_linked(g, rid, e):
    """Results joined to rid by `uses`, either direction, whether the link names a result or the
    experiment/exploration that produced it."""
    out = []
    for x in g.out(e, "uses"):  # what rid's producer uses
        out += [x] if g.type(x) == "result" else results_of(g, [x])
    out += results_of(g, g.into(rid, "uses"))  # designs that use this result
    out += results_of(g, g.into(e, "uses"))  # designs that use rid's producer (its checkpoint, data)
    return out


def brief_item(g, k):
    n = g.nodes[k]
    e = g.producer(k)
    retro = bool(e and g.type(e) == "experiment" and g.nodes[e].get("retrospective"))
    vs = [{"hypothesis": v["hypothesis"], "verdict": v["verdict"], "basis": v["basis"], "retro": retro}
          for v in g.verdicts_on(k) if v["current"]]
    return {"id": k, "title": n["title"], "producer": e, "producer_type": g.type(e),
            "producer_title": g.nodes[e]["title"] if e in g.nodes else "", "status": n.get("status"),
            "interim": bool(n.get("interim")), "verdicts": vs, "review": g.review_state(k)}


def brief_line(it):
    """id, the name of the design that produced it, verdicts, review state."""
    bits = []
    for v in it["verdicts"]:
        bits.append("%s %s: %s%s" % (v["hypothesis"], v["verdict"], short(v["basis"], 40), " [retro]" if v["retro"] else ""))
    if not it["verdicts"] and it["producer_type"] == "exploration":
        bits.append("(exploration)")
    bits.append(it["review"])
    if it["status"] == "invalidated":
        bits.append("invalidated")
    return "%-9s %-46s %s" % (it["id"], short(it["producer_title"] or it["title"], 46), "   ".join(bits))


def brief_data(g, rid, show_all=False):
    n = g.nodes[rid]
    e = g.producer(rid)
    tier_cap = g.config("brief_tier_limit")
    listed = {rid}
    retro = bool(e and g.nodes[e].get("retrospective"))
    head = {"id": rid, "title": n["title"], "summary": n.get("summary", ""), "status": n.get("status"),
            "interim": bool(n.get("interim")), "producer": e, "producer_type": g.type(e),
            "producer_status": g.status(e), "retro": retro, "review": g.review_state(rid),
            "verdicts": [dict(v, retro=retro) for v in g.verdicts_on(rid)]}

    def tier(title, ids, cap):
        ids = [k for k in ids if k not in listed and g.status(k) == "valid"]
        ids = list(dict.fromkeys(ids))
        listed.update(ids)
        shown = ids if show_all else ids[:cap]
        return {"title": title, "items": [brief_item(g, k) for k in shown], "more": len(ids) - len(shown)}

    tiers = []
    chain, linked = [], []
    if e:
        chain = results_of(g, variant_chain(g, e))
        linked = uses_linked(g, rid, e)
        for h in g.out(e, "tests"):
            linked += results_of(g, [x for x in g.into(h, "tests") if x != e])
    tiers.append(tier("Directly linked", chain + recent(g, [k for k in linked if k not in chain]), tier_cap))
    qs = result_questions(g, rid)
    under = recent(g, [r for q in qs for r in results_under(g, q)])
    qtitle = "Same question" + (" (%s)" % "; ".join("%s: %s" % (q, short(g.nodes[q]["title"], 50)) for q in qs) if qs else "")
    tiers.append(tier(qtitle, under, tier_cap))
    every = [rid] + [it["id"] for t in tiers for it in t["items"]]
    claims = [c for r in every for c in g.into(r, "derived-from", "suggested-by")
              if g.status(c) in ("pending", "supported", "active", "followed")]
    claims = recent(g, claims)
    shown = claims if show_all else claims[:tier_cap]
    claim_items = [{"id": c, "type": g.type(c), "status": g.status(c), "title": g.nodes[c]["title"],
                    "notes": claim_notes(g, c, stale=False)} for c in shown]
    open_qs = [q for q in qs if g.status(q) == "open"]
    return {"result": head, "tiers": tiers, "claims": claim_items, "claims_more": len(claims) - len(shown),
            "open_questions": [{"id": q, "title": g.nodes[q]["title"]} for q in open_qs]}


def brief_text(g, b, rid):
    h = b["result"]
    state = "" if h["status"] == "valid" and not h["interim"] else \
        "  [%s]" % ("interim: a partial result, not reviewed on its own" if h["interim"] else "invalidated")
    lines = ["# Brief: %s  %s%s" % (rid, h["title"], state)]
    if h["producer"]:
        lines.append("%s %s (%s)%s" % (h["producer_type"], h["producer"], h["producer_status"], " [retro]" if h["retro"] else ""))
    for v in h["verdicts"]:
        lines.append("verdict %s %s: %s%s%s" % (v["hypothesis"], v["verdict"], v["basis"], " [retro]" if v["retro"] else "",
                                                "" if v["current"] else " (no longer current)"))
    if h["producer_type"] == "experiment" and not h["verdicts"] and not h["interim"]:
        lines.append("verdicts: none recorded on this result")
    lines.append("summary: %s" % h["summary"])
    lines.append("review: %s" % h["review"])
    more = "(+%d more: nb brief %s --all)"
    for t in b["tiers"]:
        lines.append("## " + t["title"])
        lines.extend(brief_line(it) for it in t["items"])
        if not t["items"] and not t["more"]:
            lines.append("(none)")
        if t["more"]:
            lines.append(more % (t["more"], rid))
    lines.append("## Conclusions and leads on these results")
    lines.extend("%-9s %-10s %-9s %s%s" % (c["id"], c["type"], c["status"], short(c["title"], 60),
                                           "   " + ", ".join(c["notes"]) if c["notes"] else "") for c in b["claims"])
    if not b["claims"]:
        lines.append("(none)")
    if b["claims_more"]:
        lines.append(more % (b["claims_more"], rid))
    if b["open_questions"]:
        lines.append("## Open questions")
        lines.extend("%-9s %s" % (q["id"], q["title"]) for q in b["open_questions"])
    return lines


def cmd_brief(args):
    g = read()
    rid = g.resolve(args.id, {"result"})
    b = brief_data(g, rid, args.all)
    emit(b, args.json, brief_text(g, b, rid))


# ---------------------------------------------------------------- audit ---

def bundle_node(g, k, drop=("log",)):
    d = json.loads(serialise(g.nodes[k]))
    for f in drop:
        d.pop(f, None)
    return d


def audit_bundle(g, nid):
    n = g.nodes[nid]
    cited = [r for r in g.out(nid, "derived-from", "suggested-by") if g.type(r) == "result"]
    exps = list(dict.fromkeys(g.producer(r) for r in cited if g.producer(r)))
    hyps = set(g.out(nid, "supports", "contradicts")) | {h for e in exps for h in g.out(e, "tests")}
    hyps = {h for h in hyps if g.type(h) == "hypothesis"}
    qs = set(g.out(nid, "answers", "raises")) | {q for h in hyps for q in g.out(h, "addresses")}
    qs |= {q for e in exps for q in g.out(e, "investigates")}
    uncited = [r for r in results_of(g, exps) if r not in cited]
    near = set(r for e in exps for r in g.out(e, "produces"))
    near |= {r for h in hyps for r in g.into(h, "supports", "contradicts") if g.type(r) == "result"}
    near |= {r for h in hyps for e in g.into(h, "tests") for r in g.out(e, "produces")}
    near |= {r for q in qs for r in results_under(g, q)}
    since = [r for r in recent(g, near) if r not in cited and g.nodes[r]["created"] >= n["created"]]
    others = set()
    for h in hyps:
        others.update(g.into(h, "supports", "contradicts"))
        others.update(g.into(h, "spawns"))
    for q in qs:
        others.update(g.into(q, "answers", "raises"))
    for r in cited:
        others.update(g.into(r, "derived-from", "suggested-by"))
    others = [c for c in recent(g, others) if c != nid and g.type(c) in ("conclusion", "lead")]
    linked = {}
    for r in cited:  # the brief's linked tiers (directly linked, same question), uncapped
        linked[r] = [{"title": t["title"], "items": t["items"]} for t in brief_data(g, r, show_all=True)["tiers"]]

    def result(r):
        return dict(bundle_node(g, r), review=g.review_state(r), verdicts_on=g.verdicts_on(r))

    def experiment(e):
        keep = ("id", "type", "title", "status", "retrospective", "fresh", "spec", "execution", "predictions",
                "verdicts", "deviations", "frozen_at", "runs", "body")
        d = {k: v for k, v in bundle_node(g, e).items() if k in keep}
        d["builds_on"] = builds_on(g, e)
        d["current_verdicts"] = g.current_verdicts(e) if g.type(e) == "experiment" else {}
        return d

    def claim(c):
        a = g.latest_audit(c)
        return dict(bundle_node(g, c), latest_audit=bundle_node(g, a) if a else None)

    return {"node": dict(bundle_node(g, nid), retro=g.retro(nid)),
            "cited_results": [result(r) for r in cited],
            "experiments": [experiment(e) for e in exps],
            "uncited_results": [result(r) for r in uncited],
            "results_since": [result(r) for r in since if r not in uncited],
            "other_claims": [claim(c) for c in others],
            "linked": linked}


AUDIT_SECTIONS = [
    ("node", "The node under audit"),
    ("cited_results", "Results it rests on"),
    ("experiments", "Their experiments and explorations: frozen spec, predictions, decision rules, verdicts, deviations"),
    ("uncited_results", "Other results of those experiments, not cited"),
    ("results_since", "Results added since the node was created, on the same experiments, hypotheses or questions"),
    ("other_claims", "Other conclusions and leads on the same questions, hypotheses or results"),
    ("linked", "Linked results per cited result (the brief's tiers: directly linked, same question). Only linked "
               "work appears here; search the notebook for what is missing"),
]


def cmd_audit(args):
    g = read()
    nid = g.resolve(args.id, {"conclusion", "lead"})
    b = audit_bundle(g, nid)
    lines = ["# Audit bundle: %s  %s" % (nid, g.nodes[nid]["title"]),
             "Everything the auditor gets. JSON per item; dates are YYYY-MM-DD, *_at fields are notebook versions."]
    for key, title in AUDIT_SECTIONS:
        lines.append("")
        lines.append("## " + title)
        v = b[key]
        if not v:
            lines.append("(none)")
        elif isinstance(v, list):
            lines.extend(json.dumps(x, indent=1, ensure_ascii=False) for x in v)
        else:
            lines.append(json.dumps(v, indent=1, ensure_ascii=False))
    emit(b, args.json, lines)


def node_text(n):
    parts = [n.get(k, "") for k in ("title", "body", "summary", "rationale", "scope", "alternatives",
                                     "prediction", "spec", "findings", "revisit_if")]
    parts += n.get("rejected", []) + n.get("tags", []) + n.get("refs", [])
    return "\n".join(p for p in parts if p).lower()


def cmd_query(args):
    g = read()
    ids = []
    for k, n in g.nodes.items():
        if args.type and n["type"] != args.type:
            continue
        if args.status and n.get("status") != args.status:
            continue
        if args.author and n["author"] != args.author:
            continue
        if args.tag and not set(args.tag) <= set(n["tags"]):
            continue
        if args.since and n["updated"] < args.since:
            continue
        if args.text and args.text.lower() not in node_text(n):
            continue
        ids.append(k)
    ids.sort(key=lambda k: (g.nodes[k]["created"], k), reverse=True)
    total = len(ids)
    if not args.all:
        ids = ids[:LIST_LIMIT]
    lines = [row(g, k) for k in ids]
    if total > len(ids):
        lines.append("(+%d more; --all)" % (total - len(ids)))
    emit([node_brief(g, k) for k in ids], args.json, lines or ["no matches"])


def cmd_log(args):
    root = repo_root()
    git = Git(root)
    if not git.rev(ref_name()):
        raise NbError("no notebook in this repository; run `nb init`")
    out = git.run("log", "--date=short", "--format=%h%x09%ad%x09%s", "-n", str(args.n), ref_name()).stdout
    rows = [dict(zip(("commit", "date", "message"), l.split("\t"))) for l in out.splitlines()]
    emit(rows, args.json, ["%s %s %s" % (r["commit"], r["date"], r["message"]) for r in rows])


# ----------------------------------------------------------------- lint ---

def lint(g, full=True):
    """[(level, id, message)]. full=False skips checks that touch git history or the filesystem."""
    out = [("error", i, m) for i, m in validate(g)]
    add = lambda lvl, i, m: out.append((lvl, i, m))
    memo = {}
    old_trees = {}
    for nid in sorted(g.nodes):
        n = g.nodes[nid]
        t, st = n["type"], n.get("status")
        if t in ("experiment", "exploration") and st in ("draft", "frozen"):
            if not g.has_active_goal(nid):
                add("error", nid, "%s %s has no path to an active goal" % (st, t))
            d = g.drift(nid, memo)
            if d >= g.config("drift_leads"):
                add("warn", nid, "drift: its lineage passes through %d leads (%s)" % (d, ", ".join(g.lineage_leads(nid))))
        if t == "conclusion" and st == "supported":
            bad = [r for r in g.out(nid, "derived-from") if g.status(r) == "invalidated"]
            if bad:
                add("error", nid, "supported conclusion derives from invalidated %s" % ", ".join(bad))
            if len(g.out(nid, "derived-from")) < g.config("min_results_supported"):
                add("warn", nid, "supported by fewer than %d results" % g.config("min_results_supported"))
            contra = g.into(nid, "contradicts")
            if contra and full:
                sha = n.get("confirmed_at")
                if sha not in old_trees:
                    try:
                        old_trees[sha] = Graph.load(g.git, sha) if sha else None
                    except NbError:
                        old_trees[sha] = None
                old = old_trees[sha]
                for c in contra:
                    then = old.nodes.get(c) if old else None
                    if not then or not any(l["rel"] == "contradicts" and l["to"] == nid for l in then["links"]):
                        add("warn", nid, "contradicted by %s, added after it was confirmed" % c)
        if t in ("conclusion", "lead") and st in ("supported", "pending"):
            a = g.latest_audit(nid)
            if a and g.nodes[a].get("verdict") in ("concerns", "unsound"):
                add("warn", nid, "latest audit %s says %s" % (a, g.nodes[a]["verdict"]))
        backers = lambda rel, ty, s: [c for c in g.into(nid, rel) if g.type(c) == ty and g.status(c) == s]
        if t == "hypothesis" and st in ("supported", "refuted"):
            agree = [v for e in g.into(nid, "tests") if g.type(e) == "experiment"
                     for h, v in g.current_verdicts(e).items() if h == nid and VERDICT_STATUS.get(v["verdict"]) == st]
            if not agree and not backers("supports" if st == "supported" else "contradicts", "conclusion", "supported"):
                add("warn", nid, "%s, but neither a current verdict nor a supported conclusion that %s it is behind it"
                    % (st, "supports" if st == "supported" else "contradicts"))
        if t == "hypothesis":
            tally = g.hyp_tally(nid)
            if tally["supported"] and tally["refuted"]:
                add("warn", nid, "contested: supported by %s; refuted by %s (invalidate a flawed result or "
                    "supersede the hypothesis with a narrower one)"
                    % (", ".join(tally["supported"]), ", ".join(tally["refuted"])))
        if t == "experiment" and st == "done" and g.missing_verdicts(nid):
            add("warn", nid, "done, but no current verdict for %s (backfill with nb verdict)"
                % ", ".join(g.missing_verdicts(nid)))
        if t == "result" and g.final(nid) and not n.get("reviews") and age_days(n["created"]) > g.config("pending_days"):
            add("warn", nid, "unreviewed for %d days (nb brief %s, then a conclusion, a lead or nb nothing-yet)"
                % (age_days(n["created"]), nid))
        if t == "question" and st == "answered" and not backers("answers", "conclusion", "supported"):
            add("warn", nid, "answered, but no supported conclusion answers it any more")
        if t == "question" and st == "settled" and not backers("affects", "decision", "active"):
            add("warn", nid, "settled, but no active decision affects it any more")
        if t == "question" and st == "open" and not g.has_active_goal(nid):
            add("warn", nid, "open question with no path to an active goal (re-link, park or abandon it)")
        if st == "pending":
            try:
                age = (datetime.date.fromisoformat(today()) - datetime.date.fromisoformat(n["created"])).days
            except ValueError:
                age = 0
            if age > g.config("pending_days"):
                add("warn", nid, "pending for %d days (nb confirm or nb reject)" % age)
    for k in g.stale_interim():
        add("warn", k, "only interim results, the newest older than %d days (record the final result, or abandon)"
            % g.config("pending_days"))
    if full:
        lint_provenance(g, add)
    order = {"error": 0, "warn": 1}
    return sorted(out, key=lambda x: (order[x[0]], x[1]))


def lint_provenance(g, add):
    results = {k: n for k, n in g.nodes.items() if n["type"] == "result"}
    commits = {k: n["provenance"].get("commit") for k, n in results.items() if n["provenance"].get("commit")}
    if commits:
        res = g.git.run("rev-list", "--all", check=False)
        reachable = sorted(res.stdout.split())
        for k, c in sorted(commits.items()):
            i = bisect.bisect_left(reachable, c)
            if not (i < len(reachable) and reachable[i].startswith(c)):
                add("warn", k, "provenance commit %s is not reachable from any ref" % c[:12])
    backing = set()
    for k, n in g.nodes.items():
        if n["type"] == "conclusion" and n.get("status") == "supported":
            backing.update(g.out(k, "derived-from"))
    for k in sorted(backing):
        if k in results:
            for a in results[k]["provenance"].get("artifacts", []):
                if "://" not in a and not (g.git.root / a).exists():
                    add("warn", k, "artifact %s no longer exists" % a)


def cmd_lint(args):
    g = read()
    out = lint(g)
    emit([{"level": l, "id": i, "message": m} for l, i, m in out], args.json,
         ["%-5s  %s: %s" % (l, i, m) for l, i, m in out] or ["ok"])
    if any(l == "error" for l, _, _ in out):
        sys.exit(1)


# ---------------------------------------------------------------- prime ---

PRIME_HEAD = [
    "# lab-notebook",
    "This repo's research record (nb): goals, questions, experiments, results, conclusions.",
    "foam holds work and how-to facts; nb holds what the project found and why. "
    "Use nb context/path/query for more; nb freeze and nb confirm are the user's to approve.",
]


def last_event_date(n, event):
    for entry in reversed(n["log"]):
        if entry["event"] == event:
            return entry["date"]
    return n["created"]


def prime_text(g, max_chars):
    limit = g.config("prime_section_limit")
    nodes = g.nodes

    def pick(pred, key):
        ids = [k for k, n in nodes.items() if pred(k, n)]
        return sorted(ids, key=key, reverse=True)

    def line(k, extra="", width=80):
        n = nodes[k]
        marks = " [retro]" if g.retro(k) else ""
        return "%-10s %s%s%s" % (k, short(n["title"], width), marks, ("   " + extra) if extra else "")

    sections = []
    ids = pick(lambda k, n: n["type"] == "goal" and n["status"] == "active", lambda k: nodes[k]["created"])
    sections.append(("Goals", ids, lambda k: line(k), "nb query --type goal --status active"))
    ids = pick(lambda k, n: n.get("status") == "pending", lambda k: (nodes[k]["created"], k))
    sections.append(("Awaiting the user (pending, not established)", ids,
                     lambda k: line(k, ", ".join([nodes[k]["type"], nodes[k]["author"]] + claim_notes(g, k)
                                                 + [nodes[k]["created"]]), 60),
                     "nb pending"))
    closing = needs_closing(g)
    notes = dict(closing)
    sections.append(("Needs closing", [k for k, _ in closing], lambda k: line(k, notes[k], 55), "nb pending"))
    ids = pick(lambda k, n: n["type"] in ("experiment", "exploration") and n["status"] == "frozen",
               lambda k: last_event_date(nodes[k], "freeze"))

    def inflight(k):
        n = nodes[k]
        return line(k, "%s frozen %s, %d results, %d runs" % (n["type"], last_event_date(n, "freeze"),
                                                               len(g.out(k, "produces")), len(n["runs"])), 60)
    sections.append(("In flight (frozen)", ids, inflight, "nb query --status frozen"))
    ids = pick(lambda k, n: n["type"] == "question" and n["status"] == "open" and g.has_active_goal(k),
               lambda k: (nodes[k]["updated"], k))
    sections.append(("Open questions", ids, lambda k: line(k), "nb query --type question --status open"))
    ids = pick(lambda k, n: n["type"] == "conclusion" and n["status"] == "supported",
               lambda k: (last_event_date(nodes[k], "confirm"), k))

    def concl(k):
        bits = [("confidence " + nodes[k]["confidence"]) if nodes[k].get("confidence") else ""]
        a = g.latest_audit(k)
        if a and nodes[a].get("verdict") in ("concerns", "unsound"):
            bits.append("audit %s (%s)" % (nodes[a]["verdict"], a))
        return line(k, ", ".join(b for b in bits if b))
    sections.append(("Recent conclusions", ids, concl, "nb query --type conclusion --status supported"))
    ids = pick(lambda k, n: n["type"] == "lead" and n["status"] == "active", lambda k: (nodes[k]["updated"], k))
    sections.append(("Active leads", ids, lambda k: line(k), "nb query --type lead --status active"))

    rendered = []
    for title, ids, fmt, query in sections:
        if not ids:
            continue
        body = [fmt(k) for k in ids[:limit]]
        if len(ids) > limit:
            body.append("(+%d more: %s)" % (len(ids) - limit, query))
        rendered.append({"full": ["## " + title] + body, "short": ["## %s: %d (%s)" % (title, len(ids), query)]})
    issues = lint(g, full=False)
    errors = sum(1 for l, _, _ in issues if l == "error")
    if issues:
        msg = "## Lint: %d error%s, %d warning%s (nb lint)" % (
            errors, "" if errors == 1 else "s", len(issues) - errors, "" if len(issues) - errors == 1 else "s")
        rendered.append({"full": [msg], "short": [msg]})
    if not rendered:
        rendered.append({"full": ["(empty notebook: add a goal with nb add goal)"], "short": []})

    use = ["full"] * len(rendered)

    def text():
        out = list(PRIME_HEAD)
        for r, u in zip(rendered, use):
            out.extend(r[u])
        return "\n".join(out)

    i = len(rendered) - 1
    while len(text()) > max_chars and i >= 0:
        use[i] = "short"
        i -= 1
    t = text()
    return t if len(t) <= max_chars else t[:max_chars - 1] + "…"


def cmd_prime(args):
    try:
        git = Git(repo_root())
        if not git.rev(ref_name()):
            return
        g = Graph.load(git)
    except NbError:
        return
    text = prime_text(g, args.max_chars or g.config("prime_max_chars"))
    if args.hook_json:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}}))
    else:
        print(text)


# ----------------------------------------------------------------- sync ---

def merge_lists(bk, ok, tk):
    """Set merge: keep what either side added, drop what either side removed (unlink, retract);
    base order, then ours, then theirs."""
    bs, os_, ts = ({canonical(x) for x in l or []} for l in (bk, ok, tk))
    v, seen = [], set()
    for x in (bk or []) + (ok or []) + (tk or []):
        c = canonical(x)
        if c not in seen and (c in os_ and c in ts if c in bs else True):
            seen.add(c)
            v.append(x)
    return v


def derived_status(node):
    """Statuses nb derives (recomputed after a merge rather than conflicting)."""
    return node.get("type") == "hypothesis" or node.get("type") == "experiment"


def merge_nodes(base, ours, theirs, rederive=None):
    """Three-way merge of node dicts. Returns (merged, conflicts).

    rederive, if given, collects ids whose derived status changed differently on both sides.
    """
    merged, conflicts = {}, []
    for nid in sorted(set(base) | set(ours) | set(theirs)):
        b, o, t = base.get(nid), ours.get(nid), theirs.get(nid)
        if o == t:
            res = o
        elif o == b:
            res = t
        elif t == b:
            res = o
        elif b is None or o is None or t is None:
            conflicts.append("%s: added or removed differently on both sides" % nid)
            res = o
        else:
            res = {}
            for k in sorted(set(b) | set(o) | set(t)):
                bk, ok, tk = b.get(k), o.get(k), t.get(k)
                if k in FIXED_FIELDS and ok != tk:
                    conflicts.append("%s: %s is fixed at creation but differs (%r vs %r)" % (nid, k, ok, tk))
                    v = ok
                elif k == "verdicts" and ok != tk and ok != bk and tk != bk:
                    bs = {canonical(x) for x in bk or []}
                    new_o = {x.get("hypothesis") for x in ok or [] if canonical(x) not in bs and isinstance(x, dict)}
                    new_t = {x.get("hypothesis") for x in tk or [] if canonical(x) not in bs and isinstance(x, dict)}
                    for h in sorted(new_o & new_t):
                        conflicts.append("%s: both sides added a verdict for %s" % (nid, h))
                    v = merge_lists(bk, ok, tk)
                elif k == "status" and ok != tk and ok != bk and tk != bk and rederive is not None \
                        and derived_status(o) and (o.get("type") == "hypothesis"
                                                   or {ok, tk} <= {"frozen", "done"}):
                    rederive.add(nid)
                    v = ok
                elif ok == tk:
                    v = ok
                elif ok == bk:
                    v = tk
                elif tk == bk:
                    v = ok
                elif k in APPEND_LISTS and all(isinstance(x, list) for x in (bk or [], ok or [], tk or [])):
                    v = merge_lists(bk, ok, tk)
                elif k == "updated":
                    v = max(ok or "", tk or "")
                else:
                    conflicts.append("%s: %s changed on both sides (%r vs %r)" % (nid, k, ok, tk))
                    v = ok
                if v is not None:
                    res[k] = v
        if res is not None:
            merged[nid] = res
    return merged, conflicts


def cmd_sync(args):
    root = repo_root()
    git = Git(root)
    say = (lambda *a: None) if args.quiet else print
    ref = ref_name()
    if not git.ok("remote", "get-url", "origin"):
        raise NbError("no origin remote to sync with")
    for attempt in range(3):
        fetch = git.run("fetch", "-q", "origin", "+%s:%s" % (ref, ORIGIN_REF), check=False)
        remote = git.rev(ORIGIN_REF) if fetch.returncode == 0 else None
        if fetch.returncode != 0 and "couldn't find remote ref" not in fetch.stderr.lower():
            raise NbError("fetch failed: %s" % fetch.stderr.strip())
        local = git.rev(ref)
        if not local and not remote:
            raise NbError("no notebook locally or on origin; run `nb init`")
        if not local:
            git.swap(ref, remote, None)
            say("fetched the notebook from origin")
            return
        if remote == local:
            say("notebook up to date")
            return
        if remote and git.ok("merge-base", "--is-ancestor", local, remote):
            if not git.swap(ref, remote, local):
                continue
            say("fast-forwarded the notebook to origin")
            return
        if remote and not git.ok("merge-base", "--is-ancestor", remote, local):
            base_sha = git.run("merge-base", local, remote, check=False).stdout.strip() or None
            base = Graph.load(git, base_sha) if base_sha else Graph(git, None, {"config": {}}, {}, {})
            g_ours, g_theirs = Graph.load(git, local), Graph.load(git, remote)
            strip = lambda gr: {k: json.loads(serialise(n)) for k, n in gr.nodes.items()}
            rederive = set()
            nodes, conflicts = merge_nodes(strip(base), strip(g_ours), strip(g_theirs), rederive)
            conf, cconf = merge_nodes({"c": base.meta.get("config", {})}, {"c": g_ours.meta["config"]},
                                      {"c": g_theirs.meta["config"]})
            conflicts += [c.replace("c: ", "config: ", 1) for c in cconf]
            if conflicts:
                raise NbError("sync stopped, nothing written; resolve these with nb on one side and sync again:\n  "
                              + "\n  ".join(conflicts))
            merged = Graph(git, local, {"schema": SCHEMA, "config": conf.get("c", {})}, nodes, g_ours.blobs)
            for n in merged.nodes.values():
                for k, kind in fields_of(n.get("type")).items():
                    n.setdefault(k, default(kind))
            # Derived statuses are recomputed from the merged graph, not merged.
            merged.changed()
            hyps = [k for k, n in merged.nodes.items() if n["type"] == "hypothesis" and merged.hyp_events(k)]
            exps = [k for k, n in merged.nodes.items() if n["type"] == "experiment" and n.get("status") == "frozen"]
            changes = merged.recompute(hyps, exps, event="sync")
            # A verdict that was current on one side and is not in the merged graph (the other side
            # invalidated its result, or replaced it) was withdrawn by the merge: as after
            # `nb invalidate`, its hypothesis and experiment are re-derived, reopening a done one.
            for e, n in merged.nodes.items():
                if n["type"] != "experiment" or not n.get("verdicts"):
                    continue
                now = merged.current_verdicts(e)
                for side in (g_ours, g_theirs):
                    if e in side.nodes:
                        for h, v in side.current_verdicts(e).items():
                            if now.get(h) != v and h in merged.nodes:
                                rederive.update((h, e))
            changes += merged.recompute([k for k in rederive if merged.type(k) == "hypothesis"],
                                        [k for k in rederive if merged.type(k) == "experiment"],
                                        event="sync", reopen=True, force=True)
            for c in changes:
                say("recomputed %s" % c)
            before = set(validate(g_ours)) | set(validate(g_theirs))
            new = [e for e in validate(merged) if e not in before]
            if new:
                raise NbError("sync stopped, the merged notebook would be invalid:\n  "
                              + "\n  ".join("%s: %s" % e for e in new))
            commit = git.commit_tree(build_tree(merged), [local, remote], "nb: sync merge")
            if not git.swap(ref, commit, local):
                continue
            say("merged origin's notebook changes")
        push = git.run("push", "-q", "--no-verify", "origin", "%s:%s" % (ref, ref), check=False)
        if push.returncode == 0:
            git.run("update-ref", ORIGIN_REF, git.rev(ref), check=False)
            say("pushed the notebook to origin")
            return
        if "rejected" not in push.stderr and "fetch first" not in push.stderr:
            raise NbError("push failed: %s" % push.stderr.strip())
    raise NbError("origin kept changing during sync; try again")


# --------------------------------------------------------------- parser ---

def build_parser():
    p = argparse.ArgumentParser(prog="nb", description="The project's research record: a typed graph on a git ref.")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, help):
        sp = sub.add_parser(name, help=help, description=help)
        sp.set_defaults(fn=fn, json=False)
        return sp

    def json_flag(sp):
        sp.add_argument("--json", action="store_true", help="machine-readable output")

    add("init", cmd_init, "create the notebook ref and set up sync with origin (safe to re-run)")

    sp = add("add", cmd_add, "create a node and print its id")
    sp.add_argument("type", choices=sorted(TYPE_FIELDS))
    sp.add_argument("title")
    sp.add_argument("--body", help="markdown; '-' reads stdin")
    sp.add_argument("--ref", action="append", help="opaque reference (foam id, URL, path); repeat per value")
    sp.add_argument("--tag", action="append", help="filtering label; repeat per value")
    sp.add_argument("--link", action="append", metavar="REL:ID", help="outgoing edge; repeat per value")
    sp.add_argument("--prediction", help="hypothesis: what should be observed if it holds")
    sp.add_argument("--spec", help="experiment/exploration: what will be done ('-' reads stdin)")
    sp.add_argument("--exec", dest="execution", choices=sorted(ENUMS["execution"]))
    sp.add_argument("--retro", action="store_true", help="experiment: spec and predictions written after the results")
    sp.add_argument("--fresh", action="store_true",
                    help="experiment/exploration: builds on nothing in the notebook (else link variant-of or uses)")
    sp.add_argument("--rationale", help="conclusion/lead/decision: why ('-' reads stdin)")
    sp.add_argument("--scope", help="conclusion: where the claim holds")
    sp.add_argument("--alternatives", help="conclusion: alternatives ruled out")
    sp.add_argument("--confidence", choices=sorted(ENUMS["confidence"]))
    sp.add_argument("--from", dest="from_", action="append", metavar="RES",
                    help="conclusion: derived-from result; lead: suggested-by result; repeat per value")
    sp.add_argument("--reject", action="append", metavar="ALT", help="decision: alternative not taken; repeat per value")
    sp.add_argument("--revisit-if", dest="revisit_if")
    sp.add_argument("--origin", choices=sorted(ENUMS["origin"]),
                    help="conclusion/lead: user (drafted from the user's read) or claude (Claude's read, asked for)")
    sp.add_argument("--user-words", dest="user_words", metavar="TEXT",
                    help="conclusion/lead: the user's read, verbatim ('-' reads stdin); required with --origin user")
    sp.add_argument("--of", metavar="ID", help="audit: the audited conclusion or lead")
    sp.add_argument("--verdict", choices=sorted(ENUMS["verdict"]))
    sp.add_argument("--findings")
    sp.add_argument("--auditor")

    sp = add("predict", cmd_predict, "add a prediction (and tests link) to a draft experiment")
    sp.add_argument("experiment")
    sp.add_argument("hypothesis")
    sp.add_argument("--prediction", required=True)
    sp.add_argument("--metric", required=True)
    sp.add_argument("--rule", required=True, help="decision rule: what outcome supports or refutes")

    for name, fn, help in [("link", cmd_link, "add an edge"), ("unlink", cmd_unlink, "remove an edge (initial status only)")]:
        sp = add(name, fn, help)
        sp.add_argument("source")
        sp.add_argument("rel", choices=sorted(EDGES))
        sp.add_argument("target")

    sp = add("set", cmd_set, "change a mutable field")
    sp.add_argument("id")
    sp.add_argument("field")
    sp.add_argument("value", help="'-' reads stdin")
    g = sp.add_mutually_exclusive_group()
    g.add_argument("--append", action="store_true", help="add to a list field")
    g.add_argument("--remove", action="store_true", help="remove from a list field")

    sp = add("status", cmd_status, "change a node's status")
    sp.add_argument("id")
    sp.add_argument("status")
    sp.add_argument("--reason")

    sp = add("freeze", cmd_freeze, "freeze an experiment or exploration spec (the user's approval)")
    sp.add_argument("id")

    sp = add("deviate", cmd_deviate, "record a deviation from a frozen spec")
    sp.add_argument("id")
    sp.add_argument("text", help="'-' reads stdin")

    sp = add("result", cmd_result, "record a result of a frozen experiment or exploration")
    sp.add_argument("experiment")
    sp.add_argument("summary", help="facts only")
    sp.add_argument("--run-dir")
    sp.add_argument("--artifact", action="append", help="path or URL; repeat per value")
    sp.add_argument("--ext-id", action="append", help="W&B/MLflow/job id; repeat per value")
    sp.add_argument("--metrics", metavar="FILE", help="JSON object written by the run")
    sp.add_argument("--commit", help="code commit, if not HEAD")
    sp.add_argument("--tag", action="append")
    sp.add_argument("--link", action="append", metavar="REL:ID", help="supports or contradicts; repeat per value")
    sp.add_argument("--interim", action="store_true", help="a partial result: no verdicts, not reviewed on its own")
    sp.add_argument("--verdict", nargs=3, action="append", metavar=("HYP", "VERDICT", "BASIS"),
                    help="apply the frozen rule: supported|refuted|inconclusive and the value vs the bound; "
                         "once per predicted hypothesis")

    sp = add("verdict", cmd_verdict, "add a verdict judged on an existing result, or replace one (--replace)")
    sp.add_argument("result")
    sp.add_argument("hypothesis")
    sp.add_argument("verdict", choices=VERDICTS)
    sp.add_argument("--basis", required=True, help="the measured value and the bound from the rule")
    sp.add_argument("--replace", action="store_true", help="replace the current verdict (the user's approval)")
    sp.add_argument("--reason", help="why, required with --replace")

    sp = add("nothing-yet", cmd_nothing_yet, "record that the user reviewed results and has nothing to conclude yet")
    sp.add_argument("results", nargs="+", metavar="RES")
    sp.add_argument("--note")

    sp = add("confirm", cmd_confirm, "establish a pending node (the user's approval)")
    sp.add_argument("id")
    sp.add_argument("--also", action="append", metavar="ID",
                    help="also mark a question the conclusion answers as answered (see nb show); repeat per value")

    sp = add("reject", cmd_reject, "reject a pending node")
    sp.add_argument("id")
    sp.add_argument("--reason", required=True)

    sp = add("invalidate", cmd_invalidate, "withdraw a result")
    sp.add_argument("id")
    sp.add_argument("--reason", required=True)

    sp = add("retract", cmd_retract, "remove a mistaken supports/contradicts link from any node")
    sp.add_argument("source")
    sp.add_argument("rel", choices=["contradicts", "supports"])
    sp.add_argument("target")
    sp.add_argument("--reason", required=True)

    sp = add("config", cmd_config, "read or change notebook config")
    sp.add_argument("action", choices=["get", "set"])
    sp.add_argument("key", nargs="?")
    sp.add_argument("value", nargs="?")
    json_flag(sp)

    sp = add("show", cmd_show, "one node with its edges and history")
    sp.add_argument("id")
    json_flag(sp)

    sp = add("prime", cmd_prime, "capped briefing for the start of a session")
    sp.add_argument("--hook-json", action="store_true")
    sp.add_argument("--max-chars", type=int)

    sp = add("context", cmd_context, "a node and its neighbourhood")
    sp.add_argument("id")
    sp.add_argument("--depth", type=int, default=1)
    json_flag(sp)

    sp = add("path", cmd_path, "paths to goals and the lineage of leads")
    sp.add_argument("id")
    json_flag(sp)

    sp = add("pending", cmd_pending, "nodes awaiting the user, unreviewed results and missing verdicts")
    json_flag(sp)

    sp = add("brief", cmd_brief, "what the user needs to draw a conclusion from a result")
    sp.add_argument("id")
    sp.add_argument("--all", action="store_true", help="no per-tier caps")
    json_flag(sp)

    sp = add("audit", cmd_audit, "the bundle an auditor gets for a conclusion or lead")
    sp.add_argument("id")
    json_flag(sp)

    sp = add("gate", cmd_gate, "whether nb freeze would pass the freeze gate now")
    json_flag(sp)

    sp = add("query", cmd_query, "find nodes (newest first, %d unless --all)" % LIST_LIMIT)
    sp.add_argument("--type", choices=sorted(TYPE_FIELDS))
    sp.add_argument("--status")
    sp.add_argument("--author", choices=["user", "claude"])
    sp.add_argument("--tag", action="append")
    sp.add_argument("--since", metavar="DATE", help="updated on or after YYYY-MM-DD")
    sp.add_argument("--text")
    sp.add_argument("--all", action="store_true")
    json_flag(sp)

    sp = add("log", cmd_log, "recent notebook commits")
    sp.add_argument("-n", type=int, default=20)
    json_flag(sp)

    sp = add("lint", cmd_lint, "check the whole notebook")
    json_flag(sp)

    sp = add("sync", cmd_sync, "exchange the notebook with origin")
    sp.add_argument("--quiet", action="store_true")
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        args.fn(args)
    except NbError as e:
        if args.json:
            print(json.dumps({"error": str(e)}), file=sys.stderr)
        else:
            print("nb: %s" % e, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
