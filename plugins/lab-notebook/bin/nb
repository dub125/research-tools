    "goal": {},
    "question": {},
    "hypothesis": {"prediction": str},
    "experiment": dict({"retrospective": bool}, **RUN_FIELDS, verdicts=list),
    "exploration": {k: v for k, v in RUN_FIELDS.items() if k != "predictions"},
    "result": {"summary": str, "provenance": dict, "metrics": dict, "interim": bool, "reviews": list},
    "conclusion": dict({"rationale": str, "scope": str, "alternatives": str, "confidence": str, "confirmed_at": str},
                       **CLAIM_ORIGIN),
    "lead": dict({"rationale": str}, **CLAIM_ORIGIN),
    "decision": {"rationale": str, "rejected": list, "revisit_if": str},
    "audit": {"verdict": str, "findings": str, "auditor": str, "audited_at": str},
}
REQUIRED = {
    "hypothesis": ["prediction"], "result": ["summary"],
    "conclusion": ["rationale", "scope", "alternatives"], "lead": ["rationale"],
    "decision": ["rationale"], "audit": ["verdict", "findings"],
}
ENUMS = {
    "author": {"user", "claude"}, "execution": {"command", "analysis", "manual"},
    "confidence": {"low", "medium", "high"}, "verdict": {"sound", "concerns", "unsound"},
    "origin": {"user", "claude"},
}
# Verdicts: an experiment's frozen decision rule applied to one of its results.
VERDICTS = ["supported", "refuted", "inconclusive"]
VERDICT_STATUS = {"supported": "supported", "refuted": "refuted", "inconclusive": "open"}
VERDICT_KEYS = {"hypothesis", "verdict", "result", "basis", "date", "author"}
