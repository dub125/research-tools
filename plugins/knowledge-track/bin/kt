#!/usr/bin/env python3
"""kt: the knowledge-track CLI.

Single writer for the knowledge base at ~/.claude/knowledge (override with
KNOWLEDGE_TRACK_DIR): one JSON object per line in concepts.jsonl, sorted by id.
See SPEC.md in this plugin for the schema.

Python 3 stdlib only. Never touches the network; push with git directly.
"""

import argparse
import datetime
import difflib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

# ---------------------------------------------------------------- schema ---

# name -> (type, default). Order is the serialisation order. Adding a field is
# one line here; records without it read as the default.
FIELDS = {
    "id": (str, None),
    "name": (str, None),
    "level": (int, None),
    "aliases": (list, []),
    "tags": (list, []),
    "requires": (list, []),
    "note": (str, ""),
    "updated": (str, None),
}
REQUIRED = ["id", "name", "level", "updated"]
LIST_FIELDS = [k for k, (t, _) in FIELDS.items() if t is list]
LEVELS = {0: "unknown", 1: "heard-of", 2: "understands", 3: "can-use"}

ID_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")

DATA_FILE = "concepts.jsonl"
SIMILAR_CUTOFF = 0.75   # `set` refuses to create a concept this close to an existing one
CANDIDATE_CUTOFF = 0.6  # `check` lists fuzzy candidates at or above this
LIST_LIMIT = 50


class KtError(Exception):
    pass


def today():
    return os.environ.get("KNOWLEDGE_TRACK_TODAY") or datetime.date.today().isoformat()


def kb_dir():
    return Path(os.environ.get("KNOWLEDGE_TRACK_DIR") or Path.home() / ".claude" / "knowledge")


# ------------------------------------------------------------- matching ---

def norm(s):
    """Lowercase, punctuation and hyphens to spaces, collapse whitespace."""
    return " ".join(re.sub(r"[^a-z0-9]+", " ", s.lower()).split())


def similarity(a, b, floor=0.0):
    """Max of character similarity and word overlap, on normalised strings.

    Scores below `floor` may be returned as 0.0; the cheap upper bounds skip the
    expensive ratio() for pairs that cannot reach it.
    """
    if not a or not b:
        return 0.0
    ta, tb = set(a.split()), set(b.split())
    jaccard = len(ta & tb) / len(ta | tb)
    if jaccard >= floor and floor > 0:
        return jaccard if jaccard >= 1 else max(jaccard, difflib.SequenceMatcher(None, a, b).ratio())
    sm = difflib.SequenceMatcher(None, a, b)
    if sm.real_quick_ratio() < floor or sm.quick_ratio() < floor:
        return jaccard
    return max(sm.ratio(), jaccard)


def names_of(c):
    """Every normalised string a concept answers to."""
    return {n for n in (norm(c["id"]), norm(c["name"]), *(norm(a) for a in c["aliases"])) if n}


# ------------------------------------------------------------------- KB ---

class KB:
    def __init__(self, root):
        self.root = root
        self.path = root / DATA_FILE
        self.concepts = {}

    def load(self):
        if not self.path.exists():
            raise KtError("no knowledge base at %s (run `kt init`)" % self.root)
        for n, line in enumerate(self.path.read_text().splitlines(), 1):
            if not line.strip():
                continue
            if line.startswith(("<<<<<<<", "=======", ">>>>>>>")):
                raise KtError("%s:%d: merge conflict marker; resolve it in git first" % (DATA_FILE, n))
            try:
                rec = json.loads(line)
            except json.JSONDecodeError as e:
                raise KtError("%s:%d: invalid JSON: %s" % (DATA_FILE, n, e))
            if not isinstance(rec, dict):
                raise KtError("%s:%d: not a JSON object" % (DATA_FILE, n))
            c = {k: rec.get(k, list(d) if isinstance(d, list) else d) for k, (_, d) in FIELDS.items()}
            c.update({k: v for k, v in rec.items() if k not in FIELDS})  # kept so validate reports them
            if c["id"] in self.concepts:
                raise KtError("%s:%d: duplicate id %r" % (DATA_FILE, n, c["id"]))
            self.concepts[c["id"]] = c
        return self

    def get(self, cid):
        if cid not in self.concepts:
            raise KtError("no concept %r" % cid)
        return self.concepts[cid]

    # -- validation

    def validate(self):
        errors = []
        owner = {}  # normalised name/alias -> id, for collision detection
        for cid, c in sorted(self.concepts.items()):
            def err(msg):
                errors.append("%s: %s" % (cid, msg))
            for k in c:
                if k not in FIELDS:
                    err("unknown field %r" % k)
            for k in REQUIRED:
                if c.get(k) in (None, ""):
                    err("missing %s" % k)
            if not isinstance(cid, str) or not ID_RE.match(cid):
                err("id must be lowercase kebab-case")
            for k, (t, _) in FIELDS.items():
                v = c.get(k)
                if v is not None and not (isinstance(v, t) and not isinstance(v, bool)):
                    err("%s must be %s" % (k, t.__name__))
            if isinstance(c.get("level"), int) and c["level"] not in LEVELS:
                err("level must be 0-3")
            if isinstance(c.get("level"), int) and c["level"] >= 1 and not c.get("note"):
                err("level >= 1 needs a note saying why")
            if isinstance(c.get("updated"), str) and not DATE_RE.match(c["updated"]):
                err("updated must be YYYY-MM-DD")
            for k in LIST_FIELDS:
                v = c.get(k)
                if not isinstance(v, list):
                    continue
                if any(not isinstance(x, str) or not x.strip() for x in v):
                    err("%s items must be non-empty strings" % k)
                elif len(set(v)) != len(v):
                    err("%s has duplicates" % k)
            for r in c.get("requires") or []:
                if r == cid:
                    err("requires itself")
                elif r not in self.concepts:
                    err("requires unknown id %r" % r)
            if isinstance(c.get("name"), str) and isinstance(c.get("aliases"), list):
                for n in names_of(c):
                    other = owner.setdefault(n, cid)
                    if other != cid:
                        err("name/alias %r already belongs to %s" % (n, other))
        cycle = self.find_cycle()
        if cycle:
            errors.append("requires cycle: %s" % " -> ".join(cycle))
        return errors

    def find_cycle(self):
        state = {}

        def visit(cid, path):
            state[cid] = 1
            for r in self.concepts[cid].get("requires") or []:
                if r not in self.concepts:
                    continue
                if state.get(r) == 1:
                    return path[path.index(r):] + [r]
                if r not in state:
                    found = visit(r, path + [r])
                    if found:
                        return found
            state[cid] = 2
            return None

        for cid in sorted(self.concepts):
            if cid not in state:
                found = visit(cid, [cid])
                if found:
                    return found
        return None

    # -- writing

    def serialise(self, c):
        rec = {}
        for k, (_, d) in FIELDS.items():
            if c.get(k) != d or k in REQUIRED:
                rec[k] = c[k]
        return json.dumps(rec, ensure_ascii=False)

    def save(self, message):
        """validate -> atomic write -> local git commit. Refuses invalid state."""
        errors = self.validate()
        if errors:
            raise KtError("refused, the result would be invalid:\n  " + "\n  ".join(errors))
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text("".join(self.serialise(self.concepts[k]) + "\n" for k in sorted(self.concepts)))
        os.replace(tmp, self.path)
        return git_commit(self.root, message)

    # -- queries

    def resolve(self, term):
        """Return (id, how) for an exact match, else (None, [(score, id), ...])."""
        if term in self.concepts:
            return term, "id"
        t = norm(term)
        for c in self.concepts.values():
            if t == norm(c["id"]):
                return c["id"], "id"
            if t == norm(c["name"]):
                return c["id"], "name"
            if any(t == norm(a) for a in c["aliases"]):
                return c["id"], "alias"
        return None, self.similar(t)

    def similar(self, t, cutoff=CANDIDATE_CUTOFF, n=3, exclude=()):
        scored = []
        for c in self.concepts.values():
            if c["id"] in exclude:
                continue
            best = max(similarity(t, x, cutoff) for x in names_of(c))
            if best >= cutoff:
                scored.append((round(best, 2), c["id"]))
        return sorted(scored, key=lambda s: (-s[0], s[1]))[:n]

    def required_by(self, cid):
        return sorted(k for k, c in self.concepts.items() if cid in c["requires"])

    def gaps(self, cid, threshold):
        """Transitive prerequisites of cid with level below threshold."""
        seen, stack, out = set(), list(self.get(cid)["requires"]), []
        while stack:
            r = stack.pop()
            if r in seen or r not in self.concepts:
                continue
            seen.add(r)
            if self.concepts[r]["level"] < threshold:
                out.append(r)
            stack.extend(self.concepts[r]["requires"])
        return sorted(out)


# ------------------------------------------------------------------ git ---

def git(root, *args):
    return subprocess.run(["git", "-C", str(root)] + list(args), capture_output=True, text=True)


def git_commit(root, message):
    """Stage and commit locally if root is a git repo. Never touches the network."""
    if not (root / ".git").exists():
        return False
    git(root, "add", DATA_FILE)
    if git(root, "diff", "--cached", "--quiet").returncode == 0:
        return False
    ident = []
    if not git(root, "config", "user.name").stdout.strip():
        ident += ["-c", "user.name=kt"]
    if not git(root, "config", "user.email").stdout.strip():
        ident += ["-c", "user.email=kt@localhost"]
    res = subprocess.run(["git", "-C", str(root)] + ident + ["commit", "-q", "--no-verify", "-m", message],
                         capture_output=True, text=True)
    if res.returncode != 0:
        raise KtError("git commit failed:\n%s" % (res.stderr or res.stdout).strip())
    return True


# --------------------------------------------------------------- output ---

def split_list(values):
    """Flatten repeated, comma-separated CLI list args."""
    return [p.strip() for v in values or [] for p in v.split(",") if p.strip()]


def row(c):
    return "%-32s %d %-11s %s" % (c["id"], c["level"], LEVELS[c["level"]], c["name"])


def emit(obj, as_json, lines):
    if as_json:
        print(json.dumps(obj, indent=2, ensure_ascii=False))
    else:
        for line in lines:
            print(line)


def parse_level_filter(spec):
    m = re.match(r"^(<=|>=|<|>|=)?([0-3])$", spec.strip())
    if not m:
        raise KtError("bad --level %r (use e.g. '<2', '>=1', '3')" % spec)
    op, n = m.group(1) or "=", int(m.group(2))
    return {"<": lambda x: x < n, "<=": lambda x: x <= n, ">": lambda x: x > n,
            ">=": lambda x: x >= n, "=": lambda x: x == n}[op]


# ------------------------------------------------------------- commands ---

def cmd_init(args):
    root = kb_dir()
    root.mkdir(parents=True, exist_ok=True)
    path = root / DATA_FILE
    if not path.exists():
        path.write_text("")
    readme = root / "README.md"
    if not readme.exists():
        readme.write_text(
            "# knowledge\n\n"
            "What I know and how well: one concept per line in `concepts.jsonl`.\n"
            "Written by the `kt` CLI from the knowledge-track plugin (research-tools);\n"
            "the schema is in that plugin's SPEC.md. Read freely; write through `kt`.\n"
        )
    if not (root / ".git").exists():
        git(root, "init", "-q")
        git(root, "add", "README.md")
    git_commit(root, "kt: init")
    print("knowledge base at %s" % root)


def cmd_set(args):
    kb = KB(kb_dir()).load()
    cid = args.id
    creating = cid not in kb.concepts
    if creating:
        if not ID_RE.match(cid):
            raise KtError("id must be lowercase kebab-case")
        if args.level is None:
            raise KtError("new concept needs --level")
        name = args.name or cid.replace("-", " ")
        if not args.new:
            probe = {"id": cid, "name": name, "aliases": split_list(args.alias)}
            close = {}
            for n in names_of(probe):
                for score, other in kb.similar(n, cutoff=SIMILAR_CUTOFF):
                    close[other] = max(score, close.get(other, 0))
            if close:
                listed = ", ".join("%s (%.2f)" % kv for kv in sorted(close.items(), key=lambda kv: -kv[1]))
                raise KtError("similar concept exists: %s\n"
                              "  same thing: kt set <that-id> --alias \"%s\"\n"
                              "  different:  rerun with --new" % (listed, name))
        c = {k: (list(d) if isinstance(d, list) else d) for k, (_, d) in FIELDS.items()}
        c.update(id=cid, name=name)
        kb.concepts[cid] = c
    else:
        c = kb.concepts[cid]
    for k in args.clear or []:
        if k not in LIST_FIELDS:
            raise KtError("--clear takes one of: %s" % ", ".join(LIST_FIELDS))
        c[k] = []
    if args.name is not None:
        c["name"] = args.name
    if args.level is not None:
        c["level"] = args.level
    if args.note is not None:
        c["note"] = args.note
    for k, values in (("aliases", args.alias), ("tags", args.tag), ("requires", args.requires)):
        for v in split_list(values):
            if v not in c[k]:
                c[k].append(v)
    c["updated"] = today()
    committed = kb.save("kt: %s %s" % ("add" if creating else "set", cid))
    print(("added " if creating else "updated ") + row(c) + (" (committed)" if committed else ""))


def cmd_get(args):
    kb = KB(kb_dir()).load()
    c = kb.get(args.id)
    out = dict(c, level_name=LEVELS[c["level"]], required_by=kb.required_by(c["id"]),
               gaps=kb.gaps(c["id"], args.threshold))
    lines = [row(c)]
    for k in ("aliases", "tags", "requires", "required_by", "gaps"):
        if out[k]:
            lines.append("  %-12s %s" % (k, ", ".join(out[k])))
    if c["note"]:
        lines.append("  %-12s %s" % ("note", c["note"]))
    lines.append("  %-12s %s" % ("updated", c["updated"]))
    emit(out, args.json, lines)


def cmd_check(args):
    kb = KB(kb_dir()).load()
    results, lines = [], []
    for term in args.terms:
        cid, how = kb.resolve(term)
        if cid:
            c = kb.concepts[cid]
            results.append({"term": term, "id": cid, "level": c["level"], "matched_by": how})
            label = cid if how == "id" and term == cid else "%r -> %s (%s)" % (term, cid, how)
            lines.append("%-40s %d %s" % (label, c["level"], LEVELS[c["level"]]))
        else:
            cands = [{"id": i, "score": s, "level": kb.concepts[i]["level"]} for s, i in how]
            results.append({"term": term, "id": None, "level": 0, "candidates": cands})
            extra = "  maybe: " + ", ".join("%s (%.2f)" % (x["id"], x["score"]) for x in cands) if cands else ""
            lines.append("%-40s 0 not tracked%s" % (repr(term), extra))
    emit(results, args.json, lines)


def cmd_list(args):
    kb = KB(kb_dir()).load()
    want = parse_level_filter(args.level) if args.level else None
    tags = set(split_list(args.tag))
    hits = [c for _, c in sorted(kb.concepts.items())
            if (want is None or want(c["level"])) and tags <= set(c["tags"])]
    shown = hits if args.all else hits[:LIST_LIMIT]
    lines = [row(c) for c in shown]
    if len(shown) < len(hits):
        lines.append("... %d more (narrow with --level/--tag, or --all)" % (len(hits) - len(shown)))
    emit([{k: c[k] for k in ("id", "name", "level", "tags")} for c in shown], args.json, lines)


def cmd_gaps(args):
    kb = KB(kb_dir()).load()
    ids = kb.gaps(args.id, args.threshold)
    emit([{"id": i, "level": kb.concepts[i]["level"]} for i in ids], args.json,
         [row(kb.concepts[i]) for i in ids] or ["no prerequisites below level %d" % args.threshold])


def cmd_merge(args):
    kb = KB(kb_dir()).load()
    src, dst = kb.get(args.src), kb.get(args.dst)
    if src is dst:
        raise KtError("cannot merge a concept into itself")
    del kb.concepts[src["id"]]
    for a in [src["name"]] + src["aliases"]:
        if norm(a) not in names_of(dst) and a not in dst["aliases"]:
            dst["aliases"].append(a)
    dst["tags"] += [t for t in src["tags"] if t not in dst["tags"]]
    dst["requires"] += [r for r in src["requires"] if r not in dst["requires"] and r != dst["id"]]
    if src["level"] > dst["level"]:
        dst["level"], dst["note"] = src["level"], src["note"]
    for c in kb.concepts.values():
        if src["id"] in c["requires"]:
            c["requires"] = [r for r in c["requires"] if r != src["id"]]
            if dst["id"] not in c["requires"] and c["id"] != dst["id"]:
                c["requires"].append(dst["id"])
            c["updated"] = today()
    dst["updated"] = today()
    committed = kb.save("kt: merge %s into %s" % (src["id"], dst["id"]))
    print("merged %s into %s%s" % (src["id"], dst["id"], " (committed)" if committed else ""))


def cmd_dupes(args):
    kb = KB(kb_dir()).load()
    items = sorted(kb.concepts.values(), key=lambda c: c["id"])
    names = {c["id"]: names_of(c) for c in items}
    # Blocking: only score pairs sharing at least half the character trigrams of
    # the smaller one, so the audit stays fast on thousands of concepts.
    grams = {cid: {s[i:i + 3] for s in (n.replace(" ", "") for n in ns) for i in range(len(s) - 2)}
             for cid, ns in names.items()}
    postings = {}
    for cid, gs in grams.items():
        for g in gs:
            postings.setdefault(g, []).append(cid)
    pairs = []
    for a in items:
        shared = {}
        for g in grams[a["id"]]:
            for b in postings[g]:
                if b > a["id"]:
                    shared[b] = shared.get(b, 0) + 1
        for b, count in shared.items():
            if count < 0.5 * min(len(grams[a["id"]]), len(grams[b])):
                continue
            best = max(similarity(x, y, args.cutoff) for x in names[a["id"]] for y in names[b])
            if best >= args.cutoff:
                pairs.append((round(best, 2), a["id"], b))
    pairs.sort(key=lambda p: (-p[0], p[1], p[2]))
    shown = pairs if args.all else pairs[:LIST_LIMIT]
    lines = ["%.2f  %s  ~  %s" % p for p in shown] or ["no likely duplicates"]
    if len(shown) < len(pairs):
        lines.append("... %d more (raise --cutoff, or --all)" % (len(pairs) - len(shown)))
    emit([{"a": a, "b": b, "score": s} for s, a, b in shown], args.json, lines)


def cmd_rm(args):
    kb = KB(kb_dir()).load()
    kb.get(args.id)
    users = kb.required_by(args.id)
    if users and not args.force:
        raise KtError("%s is required by %s (use --force to drop those links)" % (args.id, ", ".join(users)))
    del kb.concepts[args.id]
    for u in users:
        kb.concepts[u]["requires"].remove(args.id)
        kb.concepts[u]["updated"] = today()
    committed = kb.save("kt: rm %s" % args.id)
    print("removed %s%s" % (args.id, " (committed)" if committed else ""))


def cmd_validate(args):
    errors = KB(kb_dir()).load().validate()
    for e in errors:
        print("error  " + e)
    if errors:
        sys.exit(1)
    print("ok")


# --------------------------------------------------------------- parser ---

def build_parser():
    p = argparse.ArgumentParser(prog="kt", description="Track what the user knows and how well.")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, help):
        sp = sub.add_parser(name, help=help, description=help)
        sp.set_defaults(fn=fn)
        return sp

    def json_flag(sp):
        sp.add_argument("--json", action="store_true", help="machine-readable output")

    add("init", cmd_init, "create the knowledge base (safe to re-run)")

    sp = add("set", cmd_set, "create or update a concept; list flags append")
    sp.add_argument("id")
    sp.add_argument("--name")
    sp.add_argument("--level", type=int, choices=sorted(LEVELS))
    sp.add_argument("--note", help="why the level is what it is")
    sp.add_argument("--alias", action="append")
    sp.add_argument("--tag", action="append")
    sp.add_argument("--requires", action="append")
    sp.add_argument("--clear", action="append", metavar="FIELD", help="empty a list field before appending")
    sp.add_argument("--new", action="store_true", help="create even if a similar concept exists")

    sp = add("get", cmd_get, "show one concept with dependents and gaps")
    sp.add_argument("id")
    sp.add_argument("--threshold", type=int, default=2)
    json_flag(sp)

    sp = add("check", cmd_check, "look up terms by id, name, or alias; suggests near matches")
    sp.add_argument("terms", nargs="+")
    json_flag(sp)

    sp = add("list", cmd_list, "list concepts (first %d unless --all)" % LIST_LIMIT)
    sp.add_argument("--level", help="e.g. '<2', '>=1', '3'")
    sp.add_argument("--tag", action="append")
    sp.add_argument("--all", action="store_true")
    json_flag(sp)

    sp = add("gaps", cmd_gaps, "transitive prerequisites below a level")
    sp.add_argument("id")
    sp.add_argument("--threshold", type=int, default=2)
    json_flag(sp)

    sp = add("merge", cmd_merge, "fold SRC into DST: names become aliases, links are rewritten")
    sp.add_argument("src")
    sp.add_argument("dst")

    sp = add("dupes", cmd_dupes, "list pairs of concepts that look like duplicates")
    sp.add_argument("--cutoff", type=float, default=SIMILAR_CUTOFF)
    sp.add_argument("--all", action="store_true")
    json_flag(sp)

    sp = add("rm", cmd_rm, "delete a concept")
    sp.add_argument("id")
    sp.add_argument("--force", action="store_true", help="also drop links that require it")

    add("validate", cmd_validate, "check the whole file against the schema")
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        args.fn(args)
    except KtError as e:
        print("kt: %s" % e, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
